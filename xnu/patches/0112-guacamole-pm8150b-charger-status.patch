+/*
+ * guacamole PM8150B SMB5, read only (smb5-reg.h / smb5-lib.c):
+ *   0x1310 USBIN INT_RT_STS bit4 USBIN_PLUGIN (smblib_get_prop_usb_present)
+ *   0x110b POWER_PATH_STATUS: bit6 USBIN suspended, bit4 USE_USBIN, bit0 valid
+ *   0x1006 BATTERY_CHARGER_STATUS_1 bits2:0: 1 trickle 2 pre 3 full-on
+ *          4 taper 5 terminate (0 inhibit, 6 pause, 7 disabled)
+ *   0x1007 BATTERY_CHARGER_STATUS_2 bit1 BAT_OV
+ * During VOOC/Warp the external charger IC feeds the battery and the SMB5
+ * may be suspended, so "charging" also trusts the gauge current.
+ */
+bool
+SweetBattery::smbStatus(bool *plugged, bool *charging, bool *full)
+{
+	uint8_t usb, path, state, err;
+	if (!fSmb || sweet_spmi_read(2, 0x1310, &usb) || sweet_spmi_read(2, 0x110b, &path) ||
+	    sweet_spmi_read(2, 0x1006, &state) || sweet_spmi_read(2, 0x1007, &err)) {
+		return false;
+	}
+	*plugged = (usb & 0x10u) != 0;
+	unsigned st = state & 7u;
+	*charging = *plugged && st >= 1 && st <= 4 && !(err & 2u);
+	*full = *plugged && st == 5 && !(err & 2u);
+	if (usb != fSmbLast[0] || path != fSmbLast[1] || state != fSmbLast[2] || err != fSmbLast[3]) {
+		fSmbLast[0] = usb;
+		fSmbLast[1] = path;
+		fSmbLast[2] = state;
+		fSmbLast[3] = err;
+		IOLog("SWEET CHARGER: usb-rt %#x path %#x state %u err %#x -> %s%s\n",
+		    usb, path, st, err, *plugged ? "plugged" : "unplugged",
+		    *charging ? ", charging" : *full ? ", full" : "");
+	}
+	return true;
+}
