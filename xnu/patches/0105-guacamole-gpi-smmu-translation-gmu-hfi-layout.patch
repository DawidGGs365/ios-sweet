-		uint32_t *h = t + 6 + 12 * q;
-		h[0] = 1;                                       /* status: enabled */
-		h[1] = GVA_HFI + 0x1000u * (q + 1);             /* queue iova */
-		h[2] = (10u << 8) | (q ? 4u : 0u);              /* type: priority 10, id */
-		h[3] = 0x1000u >> 2;                            /* size, dwords */
-		h[6] = 1;                                       /* rx watermark */
-		h[7] = 1;                                       /* tx watermark */
-		h[8] = 1;                                       /* rx request */
+	t[4] = 4;                       /* num queues */
+	t[5] = 4;                       /* active queues (KGSL counts all) */
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t *h = t + 6 + 12 * i;
+		h[0] = q[i].status;
+		h[1] = GVA_HFI + qoff + 0x1000u * i;            /* start_addr */
+		h[2] = q[i].id | (q[i].pri << 8);               /* QUEUE_HDR_TYPE(id, pri, 0, 0) */
+		h[3] = 0x1000u >> 2;                            /* queue_size, dwords */
+		h[4] = 0;                                       /* msg_size */
+		h[5] = 0;                                       /* drop_cnt */
+		h[6] = 1;                                       /* rx_wm */
+		h[7] = 1;                                       /* tx_wm */
+		h[8] = 1;                                       /* rx_req */
+		h[9] = 0;                                       /* tx_req */
+		h[10] = 0;                                      /* read_index */
