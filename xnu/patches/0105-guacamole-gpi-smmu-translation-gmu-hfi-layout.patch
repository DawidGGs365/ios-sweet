- * HFI queue table (Linux a6xx_hfi_init): 6-word table header, two 12-word
- * queue headers, command queue (id 0) and response queue (id 4), 4 KiB each.
+ * HFI queue table, KGSL S_12.1 hfi_init(): 6-dword table header, 4 queue
+ * headers of 12 dwords (cmd, msg, dbg enabled; dispatch 0 disabled), the
+ * queues at ALIGN(sizeof(table), 16) + i * 4 KiB. a640 firmware uses the
+ * non-legacy queue ids 0/1/2/3 (legacy 0/4/5/1 is a630/a615 only); s0102
+ * with a 2-queue legacy table faulted at 0xdeadbee0 and reported 0xbaddface.
  */
 static void
 gm_hfi_table(void)
 {
+	static const struct { uint32_t id, pri, status; } q[4] = {
+		{ 0, 10, 1 }, { 1, 10, 1 }, { 2, 40, 1 }, { 3, 20, 0 },
+	};
+	const uint32_t qoff = (6u * 4u + 4u * 12u * 4u + 15u) & ~15u;  /* 0xe0 */
 	uint32_t *t = (uint32_t *)(gm_va + GM_HFI);
