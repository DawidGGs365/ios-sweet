+static void
+gwr(vm_offset_t gpu, uint32_t n, uint32_t v)
+{
+	wr(gpu, GPU_REG(n), v);
+}
+
+static void
+gwr64(vm_offset_t gpu, uint32_t n, uint64_t v)
+{
+	wr(gpu, GPU_REG(n), (uint32_t)v);
+	wr(gpu, GPU_REG(n + 1), (uint32_t)(v >> 32));
+}
+
+static uint32_t
+grd(vm_offset_t gpu, uint32_t n)
+{
+	return rd(gpu, GPU_REG(n));
+}
+
+static bool
+gpu_mem_setup(void)
+{
+	if (gpumem == 0) {
+		vm_offset_t kva;
+		if (kmem_alloc_contig(kernel_map, &kva, GPUMEM_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET GPU: no contiguous GPU memory\n");
+			return false;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+		if (!pn) {
+			return false;
+		}
+		gpumem = kva;
+		gpumem_pa = ptoa_64(pn);
+	}
+	DTEntry node;
+	const void *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "sqe-firmware", &prop, &size) != kSuccess ||
+	    size < 8 || size - 4u > 0x10000u) {
+		printf("SWEET GPU: no usable /sweet-gpu sqe-firmware\n");
+		return false;
+	}
+	const uint32_t *sqe = (const uint32_t *)prop;
+	bzero((void *)gpumem, GPUMEM_SIZE);
+	memcpy((void *)(gpumem + GPUMEM_SQE), &sqe[1], size - 4u);
+	/* a6xx_ucode_check_version() for a630_sqe.fw (looks at the image as loaded) */
+	const uint32_t *img = (const uint32_t *)(gpumem + GPUMEM_SQE);
+	bool whereami = (((img[0] & 0xfu) == 0xau) && (img[2] & 0xfu) >= 1u) || (img[0] & 0xfffu) >= 0x190u;
+	printf("SWEET GPU: SQE %u bytes, version %#x (dw0 %#x dw2 %#x): %s\n", size - 4u,
+	    img[0] & 0xfffu, img[0], img[2], whereami ? "has WHERE_AM_I, ok" : "TOO OLD (< 0x190)");
+	/* tables: L1[0] -> L2, L2[8] -> L3 (GPU VA 0x01000000..0x011fffff) */
+	uint64_t *l1 = (uint64_t *)gpumem, *l2 = (uint64_t *)(gpumem + 0x1000u), *l3 = (uint64_t *)(gpumem + 0x2000u);
+	l1[0] = (gpumem_pa + 0x1000u) | PTE_TABLE;
+	l2[(GVA_SQE >> 21) & 0x1ffu] = (gpumem_pa + 0x2000u) | PTE_TABLE;
+	for (uint32_t o = 0; o < 0x10000u; o += 0x1000u) {
+		l3[((GVA_SQE + o) >> 12) & 0x1ffu] = (gpumem_pa + GPUMEM_SQE + o) | PTE_AF | PTE_SH_OS |
+		    PTE_AP_UNPRIV | PTE_AP_RO | PTE_PAGE;
+	}
+	for (uint32_t o = 0; o < RB_SIZE; o += 0x1000u) {
+		l3[((GVA_RB + o) >> 12) & 0x1ffu] = (gpumem_pa + GPUMEM_RB + o) | PTE_AF | PTE_SH_OS |
+		    PTE_AP_UNPRIV | PTE_AP_RO | PTE_PAGE;
+	}
+	l3[(GVA_SHADOW >> 12) & 0x1ffu] = (gpumem_pa + GPUMEM_SHADOW) | PTE_AF | PTE_SH_OS | PTE_PAGE;
+	flush_dcache64((addr64_t)gpumem, GPUMEM_SIZE, FALSE);
+	printf("SWEET GPU: GPU memory %#llx: SQE @%#llx RB @%#llx shadow @%#llx (GPU VA)\n",
+	    (unsigned long long)gpumem_pa, GVA_SQE, GVA_RB, GVA_SHADOW);
+	return whereami;
+}
+
+static bool
+gpu_smmu_gpu_context(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!smmu) {
+		return false;
+	}
+	wr(smmu, SMMU_CB1 + 0x000, 0);
+	wr(smmu, SMMU_GR1 + 0x004, (1u << 16) | (0xfu << 12) | (3u << 8) | 2u);  /* CBAR1: S1, WB, NSH, VMID 2 */
+	wr(smmu, SMMU_GR1 + 0x804, 1u);                                         /* CBA2R1: VA64 */
+	wr(smmu, SMMU_CB1 + 0x010, (7u << 15) | (1u << 4) | 1u);
+	wr64(smmu, SMMU_CB1 + 0x020, gpumem_pa);
+	wr64(smmu, SMMU_CB1 + 0x028, 0);
+	wr(smmu, SMMU_CB1 + 0x030, 32u | (2u << 12) | (1u << 23));
+	wr(smmu, SMMU_CB1 + 0x034, 0);
+	wr(smmu, SMMU_CB1 + 0x038, 0xf404ff44u);
+	wr(smmu, SMMU_CB1 + 0x03c, 0);
+	wr(smmu, SMMU_CB1 + 0x058, rd(smmu, SMMU_CB1 + 0x058));
+	wr(smmu, SMMU_CB1 + 0x618, 0);
+	wr(smmu, SMMU_CB1 + 0x7f0, 0);
+	bool sync = wait_bits(smmu, SMMU_CB1 + 0x7f4, 1u, false, 1000);
+	const uint32_t sids[2] = {0x000u, 0x400u};
+	bool stuck = true;
+	for (unsigned i = 0; i < 2; ++i) {
+		wr(smmu, 0xc00 + 4 * (4 + i), 1u);                  /* S2CR4/5 -> CB1 */
+		wr(smmu, 0x800 + 4 * (4 + i), (1u << 31) | sids[i]);
+		uint32_t smr = rd(smmu, 0x800 + 4 * (4 + i));
+		stuck &= smr == ((1u << 31) | sids[i]);
+		printf("SWEET GPU: smmu SMR%u %#010x S2CR%u %#010x\n", 4 + i, smr, 4 + i, rd(smmu, 0xc00 + 4 * (4 + i)));
+	}
+	wr(smmu, SMMU_CB1 + 0x000, 0x1067u);
+	printf("SWEET GPU: smmu CB1 (GPU) sync %s SCTLR %#x TTBR0 %#llx FSR %#x sGFSR %#x\n",
+	    sync ? "ok" : "TIMEOUT", rd(smmu, SMMU_CB1), (unsigned long long)rd64(smmu, SMMU_CB1 + 0x020),
+	    rd(smmu, SMMU_CB1 + 0x058), rd(smmu, 0x48));
+	return sync && stuck;
+}
+
+static bool
+gpu_stage7(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	if (!gpu || !gmu) {
+		return false;
+	}
+	printf("SWEET GPU: stage 7: GPU SMMU context + memory + hw_init registers (CP stays halted)\n");
+	if (!gpu_mem_setup() || !gpu_smmu_gpu_context()) {
+		return false;
+	}
+	gpu_checkpoint("about to program the GPU registers");
+	gwr(gpu, 0x3c45, 0);                              /* GBIF_HALT */
+	gwr(gpu, 0x0016, 0);                              /* RBBM_GBIF_HALT */
+	gwr(gpu, 0xf803, 0);                              /* RBBM_SECVID_TSB_CNTL */
+	gwr64(gpu, 0xf800, 0);                            /* TSB_TRUSTED_BASE */
+	gwr(gpu, 0xf802, 0);                              /* TSB_TRUSTED_SIZE */
+	static const uint16_t addr_mode[] = {0x842, 0xc01, 0x8601, 0x8e05, 0x9e01, 0xbe05,
+	    0xa601, 0x9601, 0xe00, 0xae01, 0xb601, 0xf810};
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); ++i) {
+		gwr(gpu, addr_mode[i], 1);                    /* *_ADDR_MODE_CNTL: 64-bit */
+	}
+	/* HWCG: gate the SP clock while programming (GMU GX_SPTPRAC_CLOCK_CONTROL bit 0) */
+	wr(gmu, GMU_R(0x80), rd(gmu, GMU_R(0x80)) & ~1u);
+	for (unsigned i = 0; i < sizeof(a640_hwcg) / sizeof(a640_hwcg[0]); ++i) {
+		gwr(gpu, a640_hwcg[i].reg, a640_hwcg[i].val);
+	}
+	wr(gmu, GMU_R(0x80), rd(gmu, GMU_R(0x80)) | 1u);
+	gwr(gpu, 0x00ae, 0x8aa8aa82u);                    /* RBBM_CLOCK_CNTL */
+	for (unsigned i = 0; i < 4; ++i) {
+		gwr(gpu, 0x3c03 + i, 0x00071620u);            /* GBIF_QSB_SIDE0..3 */
+	}
+	gwr(gpu, 0x0011, 0x3);                            /* RBBM_GBIF_CLIENT_QOS_CNTL */
+	gwr(gpu, 0x050b, 0xffffffffu);                    /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+	gwr64(gpu, 0x0e05, 0x0001ffffffffffc0ull);        /* UCHE_WRITE_RANGE_MAX */
+	gwr64(gpu, 0x0e09, 0x0001fffffffff000ull);        /* UCHE_TRAP_BASE */
+	gwr64(gpu, 0x0e07, 0x0001fffffffff000ull);        /* UCHE_WRITE_THRU_BASE */
+	gwr64(gpu, 0x0e0b, 0x00100000ull);                /* UCHE_GMEM_RANGE_MIN */
+	gwr64(gpu, 0x0e0d, 0x00100000ull + 0x100000ull - 1); /* UCHE_GMEM_RANGE_MAX (GMEM 1 MiB) */
+	gwr(gpu, 0x0e18, 0x804);                          /* UCHE_FILTER_CNTL */
+	gwr(gpu, 0x0e17, 0x4);                            /* UCHE_CACHE_WAYS */
+	gwr(gpu, 0x08c2, 0x02000140u);                    /* CP_ROQ_THRESHOLDS_2 */
+	gwr(gpu, 0x08c1, 0x8040362cu);                    /* CP_ROQ_THRESHOLDS_1 */
+	gwr(gpu, 0x08c3, 128);                            /* CP_MEM_POOL_SIZE */
+	gwr(gpu, 0x9e00, 0x00200200u);                    /* PC_DBG_ECO_CNTL */
+	gwr(gpu, 0x098d, 0x1);                            /* CP_AHB_CNTL */
+	gwr(gpu, 0x0500, 0x1);                            /* RBBM_PERFCTR_CNTL */
+	gwr(gpu, 0x08d0, 0);                              /* CP_PERFCTR_CP_SEL(0): ALWAYS_COUNT */
+	gwr(gpu, 0x8e08, (1u << 4) | (2u << 1));          /* RB_NC_MODE_CNTL: amsbc, hbb_lo 2 */
+	gwr(gpu, 0xb604, 2u << 1);                        /* TPL1_NC_MODE_CNTL */
+	gwr(gpu, 0xae02, 2u << 1);                        /* SP_NC_MODE_CNTL */
+	gwr(gpu, 0x0e01, 2u << 21);                       /* UCHE_MODE_CNTL */
+	gwr(gpu, 0x001f, (1u << 30) | 0x1fffffu);         /* RBBM_INTERFACE_HANG_INT_CNTL */
+	gwr(gpu, 0x0e19, 1);                              /* UCHE_CLIENT_PF */
+	gwr(gpu, 0x084f, 0x1u | 0x2u | 0x8u);             /* CP_PROTECT_CNTL */
+	for (unsigned i = 0; i < 31; ++i) {
+		gwr(gpu, 0x850 + i, a6xx_protect[i]);         /* CP_PROTECT(i) */
+	}
+	gwr(gpu, 0x850 + 31, a6xx_protect[31]);
+	/* adreno_hw_init: ring empty, pointers 0 */
+	gwr(gpu, 0x0807, 0);                              /* CP_RB_WPTR */
+	gwr64(gpu, 0x0830, GVA_SQE);                      /* CP_SQE_INSTR_BASE */
+	gwr64(gpu, 0x0800, GVA_RB);                       /* CP_RB_BASE */
+	gwr(gpu, 0x0802, 0x0800020cu);                    /* CP_RB_CNTL: BUFSZ 12, BLKSZ 2, NO_UPDATE */
+	gwr64(gpu, 0x0804, GVA_SHADOW);                   /* CP_RB_RPTR_ADDR */
+
+	printf("SWEET GPU: readback RB_BASE %#x:%#x RB_CNTL %#x SQE_BASE %#x:%#x RPTR_ADDR %#x:%#x\n",
+	    grd(gpu, 0x801), grd(gpu, 0x800), grd(gpu, 0x802), grd(gpu, 0x831), grd(gpu, 0x830),
+	    grd(gpu, 0x805), grd(gpu, 0x804));
+	printf("SWEET GPU: readback CLOCK_CNTL %#x PROTECT_CNTL %#x PROTECT31 %#x GMEM_MAX %#x ROQ2 %#x\n",
+	    grd(gpu, 0x0ae), grd(gpu, 0x84f), grd(gpu, 0x86f), grd(gpu, 0xe0d), grd(gpu, 0x8c2));
+	printf("SWEET GPU: status RBBM %#x INT_0 %#x CP_HW_FAULT %#x CP_PROTECT_STATUS %#x RPTR %#x WPTR %#x SQE_CNTL %#x\n",
+	    grd(gpu, 0x210), grd(gpu, 0x201), grd(gpu, 0x821), grd(gpu, 0x824), grd(gpu, 0x806),
+	    grd(gpu, 0x807), grd(gpu, 0x808));
+	gpu_gmu_report(gmu, "stage 7");
+	printf("SWEET GPU: stage 7 done: GPU programmed, CP still halted (no SQE_CNTL write)\n");
+	return true;
+}
+
+/*
+ * ===== Stage 8: start the CP, first commands =====
+ *
+ * Linux v6.6 hw_init()/a6xx_cp_init()/a6xx_flush(): CP_SQE_CNTL = 1, then
+ * one CP_ME_INIT (opcode 72, 8 dwords: 0x2f, 3, 0x20000000, 0 x5) and, as
+ * update_shadow_rptr() does on WHERE_AM_I-capable a640 microcode, a
+ * CP_WHERE_AM_I (98) that writes the read pointer to the shadow; then
+ * CP_RB_WPTR. Type-7 header: 0x70000000 | cnt | parity(cnt) << 15 |
+ * opcode << 16 | parity(opcode) << 23 (adreno_gpu.h OUT_PKT7/PM4_PARITY).
+ * Idle = rptr == wptr and RBBM_STATUS & ~CP_AHB_BUSY_CX_MASTER == 0.
+ * No zap shader yet: the GPU stays in its secure mode (stage 9).
+ */
+static uint32_t
+pm4_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	    (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static uint32_t
+pkt7(uint32_t opcode, uint32_t cnt)
+{
+	return 0x70000000u | cnt | (pm4_parity(cnt) << 15) | ((opcode & 0x7fu) << 16) |
+	       (pm4_parity(opcode) << 23);
+}
+
+static void
+gpu_cp_report(vm_offset_t gpu, const char *when)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+	printf("SWEET GPU: [%s] SQE_CNTL %#x RBBM_STATUS %#x INT_0 %#x CP_INT %#x CP_HW_FAULT %#x\n",
+	    when, grd(gpu, 0x808), grd(gpu, 0x210), grd(gpu, 0x201), grd(gpu, 0x823), grd(gpu, 0x821));
+	printf("SWEET GPU: [%s] CP_STATUS_1 %#x PROTECT_STATUS %#x RB_RPTR %#x WPTR %#x shadow %#x\n",
+	    when, grd(gpu, 0x825), grd(gpu, 0x824), grd(gpu, 0x806), grd(gpu, 0x807),
+	    *(volatile uint32_t *)(gpumem + GPUMEM_SHADOW));
+	if (smmu) {
+		printf("SWEET GPU: [%s] smmu CB1 FSR %#x FSYNR0 %#x FAR %#llx sGFSR %#x sGFSYNR0 %#x\n",
+		    when, rd(smmu, SMMU_CB1 + 0x058), rd(smmu, SMMU_CB1 + 0x068),
+		    (unsigned long long)rd64(smmu, SMMU_CB1 + 0x060), rd(smmu, 0x48), rd(smmu, 0x50));
+	}
+}
+
+static bool
+gpu_stage8(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	printf("SWEET GPU: stage 8: start the CP\n");
+	uint32_t *rb = (uint32_t *)(gpumem + GPUMEM_RB);
+	unsigned w = 0;
+	rb[w++] = pkt7(72, 8);                            /* CP_ME_INIT */
+	rb[w++] = 0x0000002f;
+	rb[w++] = 0x00000003;                             /* multiple hw contexts */
+	rb[w++] = 0x20000000;                             /* error detection */
+	rb[w++] = 0;
+	rb[w++] = 0;
+	rb[w++] = 0;                                      /* no workarounds */
+	rb[w++] = 0;
+	rb[w++] = 0;
+	rb[w++] = pkt7(98, 2);                            /* CP_WHERE_AM_I -> shadow */
+	rb[w++] = (uint32_t)GVA_SHADOW;
+	rb[w++] = (uint32_t)(GVA_SHADOW >> 32);
+	*(volatile uint32_t *)(gpumem + GPUMEM_SHADOW) = 0xdeadbeefu;
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_RB), RB_SIZE, FALSE);
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+	printf("SWEET GPU: ring: ME_INIT hdr %#x, WHERE_AM_I hdr %#x, %u dwords\n", rb[0], rb[9], w);
+	gpu_cp_report(gpu, "before SQE start");
+
+	gpu_checkpoint("about to write CP_SQE_CNTL = 1");
+	gwr(gpu, 0x808, 1);                               /* CP_SQE_CNTL: start the SQE */
+	delay(1000);
+	gpu_cp_report(gpu, "SQE started");
+	if (grd(gpu, 0x823) || grd(gpu, 0x821)) {
+		printf("SWEET GPU: CP fault right after SQE start; ring not submitted\n");
+		return false;
+	}
+
+	gpu_checkpoint("about to submit the ring (CP_RB_WPTR)");
+	gwr(gpu, 0x807, w);                               /* CP_RB_WPTR */
+	unsigned ms = 0;
+	uint32_t shadow = 0;
+	bool idle = false;
+	for (; ms < 500; ++ms) {
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+		shadow = *(volatile uint32_t *)(gpumem + GPUMEM_SHADOW);
+		if (shadow == w && !(grd(gpu, 0x210) & ~1u) && !(grd(gpu, 0x201) & (1u << 23))) {
+			idle = true;
+			break;
+		}
+		if (grd(gpu, 0x823) || grd(gpu, 0x821)) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET GPU: ring %s after %u ms: shadow rptr %#x (want %#x)\n",
+	    idle ? "DRAINED, CP idle" : "NOT drained", ms, shadow, w);
+	gpu_cp_report(gpu, "after submit");
+	if (idle) {
+		printf("SWEET GPU: stage 8 done: the CP executed ME_INIT and WHERE_AM_I\n");
+	}
+	return idle;
+}
+
+/*
+ * ===== Stage 9: zap shader through TrustZone, leave secure mode =====
+ *
+ * Linux v6.6 a6xx_zap_shader_init() -> adreno zap loader -> qcom_mdt_load()
+ * with PAS id 13 (live DT /soc/qcom,kgsl-hyp qcom,pas-id 13, "a640_zap"),
+ * then hw_init()'s CP_SET_SECURE_MODE(0) packet. SCM over SMCCC (Linux
+ * qcom_scm-smc.c): x0 = 0x42000000 | svc << 8 | cmd (std call, SMC64, SIP
+ * owner), x1 = arginfo (count | type << (4 + 2 i), RW = 2), x2.. = args;
+ * x0 = status, x1 = first result; status 1 (INTERRUPTED) re-enters with
+ * x0 = 1 and x6 as returned. PIL svc 2: INIT_IMAGE 1 (pas, metadata PA),
+ * MEM_SETUP 2 (pas, addr, size), AUTH_AND_RESET 5 (pas), IS_SUPPORTED 7.
+ * Metadata = ELF header + phdrs + hash segment = a640_zap.mdt as shipped;
+ * it goes to uncached low RAM outside XNU's window (0xf0000000). The
+ * loadable segments (a640_zap.bNN, NN = phdr index) go to the reserved
+ * 8 KiB pil_gpu_region 0x98b15000, relocated if the ELF says so.
+ */
+#define ZAP_PAS_ID        13u
+#define ZAP_MEM_SIZE      0x200000u   /* 1 MiB aligned, 2 MiB span for headroom */
+#define ZAP_META_PA       0xf0000000u
+#define ZAP_META_SIZE     0x4000u
+
+static vm_offset_t zap_mem;       /* kernel VA of the 1 MiB-aligned PAS region */
+static uint64_t zap_mem_pa;
+
+static bool
+gpu_zap_mem_alloc(void)
+{
+	if (zap_mem) {
+		return true;
+	}
+	/* kmem_alloc_contig's alignment-mask argument did not 1 MiB-align the
+	 * result on this kernel (0x0023 got 0x1060b8000). So over-allocate by
+	 * 1 MiB and take the aligned physical sub-block ourselves; the extra
+	 * span means the aligned PA still has ZAP_MEM_SIZE usable bytes. The
+	 * block is physically contiguous, so a contiguous PA range maps to a
+	 * contiguous VA range at the same offset. */
+	vm_offset_t kva;
+	vm_size_t total = ZAP_MEM_SIZE + 0x100000u;
+	if (kmem_alloc_contig(kernel_map, &kva, total, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: no contiguous zap memory\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (!pn) {
+		return false;
+	}
+	uint64_t base_pa = ptoa_64(pn);
+	uint64_t aligned_pa = (base_pa + 0xfffffu) & ~0xfffffull;
+	zap_mem = kva + (vm_offset_t)(aligned_pa - base_pa);
+	zap_mem_pa = aligned_pa;
+	printf("SWEET GPU: zap memory alloc %#llx -> aligned %#llx (+%#x, %s)\n",
+	    (unsigned long long)base_pa, (unsigned long long)zap_mem_pa, ZAP_MEM_SIZE,
+	    (zap_mem_pa & 0xfffffu) ? "STILL NOT ALIGNED!" : "1MiB-aligned");
+	return (zap_mem_pa & 0xfffffu) == 0;
+}
+
+static uint64_t
+scm_call(uint32_t cmd, uint32_t arginfo, uint64_t a2, uint64_t a3, uint64_t a4, uint64_t *res)
+{
+	register uint64_t x0 __asm__("x0") = 0x42000000u | (2u << 8) | cmd;
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	register uint64_t x4 __asm__("x4") = a4;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	for (unsigned tries = 0; tries < 1000; ++tries) {
+		__asm__ volatile ("smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6)
+		    : : "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		if (x0 != 1) {                                /* QCOM_SCM_INTERRUPTED */
+			break;
+		}
+		x0 = 1;                                       /* resume; x6 carries the session */
+	}
+	if (res) {
+		*res = x1;
+	}
+	return x0;
+}
+
+static const void *
+gpu_adt_blob(const char *name, unsigned *size)
+{
+	DTEntry node;
+	const void *prop;
+	unsigned int sz;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, name, &prop, &sz) != kSuccess) {
+		return NULL;
+	}
+	*size = sz;
+	return prop;
+}
+
+static bool
+gpu_zap_load(void)
+{
+	uint64_t r = 0;
+	/* 0099 left no stage-9 line at all: make the first SMC observable. */
+	gpu_checkpoint("about to call SCM PAS_IS_SUPPORTED(13) (first SMC to the SIP service)");
+	uint64_t st = scm_call(7, 1, ZAP_PAS_ID, 0, 0, &r);
+	printf("SWEET GPU: SCM PAS_IS_SUPPORTED(13) status %#llx result %#llx%s\n",
+	    (unsigned long long)st, (unsigned long long)r,
+	    (st || r != 1) ? " (ignored: Linux's zap loader never asks, it goes straight to INIT_IMAGE)" : "");
+	unsigned msz = 0;
+	const uint8_t *mdt = gpu_adt_blob("zap-metadata", &msz);
+	if (!mdt || msz < 0x34 || msz > ZAP_META_SIZE || mdt[0] != 0x7f || mdt[4] != 1) {
+		printf("SWEET GPU: zap-metadata missing or not ELF32\n");
+		return false;
+	}
+	uint32_t phoff = *(const uint32_t *)(mdt + 0x1c);
+	unsigned phnum = *(const uint16_t *)(mdt + 0x2c), phsz = *(const uint16_t *)(mdt + 0x2a);
+	if (phsz != 32 || phnum > 8 || phoff + phnum * 32u > msz) {
+		printf("SWEET GPU: zap ELF phdrs unexpected (off %#x n %u sz %u)\n", phoff, phnum, phsz);
+		return false;
+	}
+	/* Linux __qcom_mdt_load: relocate = any PT_LOAD with flag bit 27; extent
+	 * is min(p_paddr)..ALIGN(max(p_paddr+p_memsz), 4K) over loadable segments;
+	 * MEM_SETUP is called only when relocatable; segment offset = p_paddr -
+	 * (relocate ? min_addr : mem_phys). */
+	uint32_t min_a = 0xffffffffu, max_a = 0;
+	bool reloc = false;
+	for (unsigned i = 0; i < phnum; ++i) {
+		const uint32_t *ph = (const uint32_t *)(mdt + phoff + 32u * i);
+		bool hash = (ph[6] & (7u << 24)) == (2u << 24);
+		printf("SWEET GPU: zap phdr %u type %u off %#x paddr %#x filesz %#x memsz %#x flags %#x align %#x%s\n",
+		    i, ph[0], ph[1], ph[3], ph[4], ph[5], ph[6], ph[7], hash ? " (hash)" : "");
+		if (ph[0] != 1 || hash || !ph[5]) {
+			continue;
+		}
+		if (ph[6] & (1u << 27)) {
+			reloc = true;
+		}
+		if (ph[3] < min_a) {
+			min_a = ph[3];
+		}
+		uint32_t end = (ph[3] + ph[5] + 0xfffu) & ~0xfffu;
+		if (end > max_a) {
+			max_a = end;
+		}
+	}
+	if (min_a >= max_a || max_a - min_a > ZAP_MEM_SIZE) {
+		printf("SWEET GPU: zap extent %#x..%#x does not fit %#x\n", min_a, max_a, ZAP_MEM_SIZE);
+		return false;
+	}
+	if (!gpu_zap_mem_alloc()) {
+		return false;
+	}
+	uint32_t mem_reloc = reloc ? min_a : (uint32_t)zap_mem_pa;
+	vm_offset_t meta = ml_io_map(ZAP_META_PA, ZAP_META_SIZE);
+	if (!meta) {
+		return false;
+	}
+	for (unsigned i = 0; i < msz / 4u; ++i) {
+		wr(meta, 4u * i, ((const uint32_t *)mdt)[i]);
+	}
+	gpu_checkpoint("about to call SCM PAS_INIT_IMAGE(13)");
+	st = scm_call(1, 2u | (2u << 6), ZAP_PAS_ID, ZAP_META_PA, 0, &r);
+	printf("SWEET GPU: SCM PAS_INIT_IMAGE status %#llx result %#llx\n",
+	    (unsigned long long)st, (unsigned long long)r);
+	if (st || r) {
+		return false;
+	}
+	if (reloc) {
+		st = scm_call(2, 3, ZAP_PAS_ID, zap_mem_pa, max_a - min_a, &r);
+		printf("SWEET GPU: SCM PAS_MEM_SETUP(%#llx, %#x) status %#llx result %#llx\n",
+		    (unsigned long long)zap_mem_pa, max_a - min_a, (unsigned long long)st, (unsigned long long)r);
+		if (st || r) {
+			return false;
+		}
+	} else {
+		printf("SWEET GPU: zap image not relocatable; skipping MEM_SETUP\n");
+	}
+	for (unsigned i = 0; i < phnum; ++i) {
+		const uint32_t *ph = (const uint32_t *)(mdt + phoff + 32u * i);
+		bool hash = (ph[6] & (7u << 24)) == (2u << 24);
+		if (ph[0] != 1 || hash || !ph[4]) {
+			continue;
+		}
+		int64_t off = (int64_t)ph[3] - (int64_t)mem_reloc;
+		if (off < 0 || (uint64_t)off + ph[5] > ZAP_MEM_SIZE) {
+			printf("SWEET GPU: zap segment %u outside memory range (off %#llx)\n", i,
+			    (unsigned long long)off);
+			return false;
+		}
+		char name[8] = "zap-b0";
+		name[6] = (char)('0' + i);
+		name[7] = 0;
+		unsigned bsz = 0;
+		const uint32_t *seg = gpu_adt_blob(name, &bsz);
+		if (!seg || bsz < ph[4]) {
+			printf("SWEET GPU: %s missing or short (%u < %#x)\n", name, bsz, ph[4]);
+			return false;
+		}
+		for (uint32_t k = 0; k < ph[4] / 4u; ++k) {
+			*(volatile uint32_t *)(zap_mem + (uint32_t)off + 4u * k) = seg[k];
+		}
+		printf("SWEET GPU: zap segment %u (%s, %#x bytes) at %#llx\n", i, name, ph[4],
+		    (unsigned long long)(zap_mem_pa + (uint32_t)off));
+	}
+	flush_dcache64((addr64_t)zap_mem, ZAP_MEM_SIZE, FALSE);
+	gpu_checkpoint("about to call SCM PAS_AUTH_AND_RESET(13)");
+	st = scm_call(5, 1, ZAP_PAS_ID, 0, 0, &r);
+	printf("SWEET GPU: SCM PAS_AUTH_AND_RESET status %#llx result %#llx\n",
+	    (unsigned long long)st, (unsigned long long)r);
+	return st == 0 && r == 0;
+}
+
+static bool
+gpu_stage9(void)
+{
+	printf("SWEET GPU: stage 9: zap shader + leave secure mode\n");
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	if (!gpu_zap_load()) {
+		printf("SWEET GPU: zap shader not loaded; GPU stays in secure mode\n");
+		return false;
+	}
+	uint32_t *rb = (uint32_t *)(gpumem + GPUMEM_RB);
+	unsigned w = grd(gpu, 0x807);
+	rb[w++] = pkt7(102, 1);                           /* CP_SET_SECURE_MODE */
+	rb[w++] = 0;
+	rb[w++] = pkt7(98, 2);                            /* CP_WHERE_AM_I */
+	rb[w++] = (uint32_t)GVA_SHADOW;
+	rb[w++] = (uint32_t)(GVA_SHADOW >> 32);
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_RB), RB_SIZE, FALSE);
+	gwr(gpu, 0x807, w);
+	unsigned ms = 0;
+	uint32_t shadow = 0;
+	for (; ms < 500; ++ms) {
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+		shadow = *(volatile uint32_t *)(gpumem + GPUMEM_SHADOW);
+		if (shadow == w || grd(gpu, 0x823) || grd(gpu, 0x821)) {
+			break;
+		}
+		delay(1000);
+	}
+	bool ok = shadow == w && !grd(gpu, 0x823) && !grd(gpu, 0x821);
+	printf("SWEET GPU: CP_SET_SECURE_MODE(0) %s after %u ms (shadow %#x want %#x)\n",
+	    ok ? "executed" : "FAILED", ms, shadow, w);
+	gpu_cp_report(gpu, "secure mode off");
+	if (ok) {
+		printf("SWEET GPU: stage 9 done: zap authenticated, GPU out of secure mode\n");
+	}
+	return ok;
+}
+
+/*
+ * ===== Stage 10: command-path self-test (indirect buffer + fence) =====
+ *
+ * The real Mesa path, in miniature and entirely in the kernel: build a
+ * command buffer in GPU memory, run it from the ring with CP_INDIRECT_BUFFER
+ * (opcode 63, iova + dword count), and signal completion with a timestamp
+ * fence (CP_EVENT_WRITE CACHE_FLUSH_TS, Linux a6xx_gpu.c submit). The IB
+ * does two CP_MEM_WRITE (opcode 61: iova, value) to a scratch GPU buffer.
+ * Success = both scratch words and the fence word land in memory, read back
+ * through the same SMMU (CB1). Proves IB dispatch, GPU DMA writes and the
+ * fence that Mesa waits on. GPU VA layout adds: IB at 0x01030000, scratch
+ * at 0x01040000, fence at 0x01050000 (all in the stage-7 1 MiB block).
+ */
+#define GPUMEM_IB         0x40000u
+#define GPUMEM_SCRATCH    0x50000u
+#define GPUMEM_FENCE      0x60000u
+#define GVA_IB            0x01030000ull
+#define GVA_SCRATCH       0x01040000ull
+#define GVA_FENCE         0x01050000ull
+
+static bool
+gpu_stage10(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu || !gpumem) {
+		return false;
+	}
+	printf("SWEET GPU: stage 10: IB + fence self-test\n");
+
+	/* Map the three new buffers into the GPU's CB1 page tables (RW). The
+	 * stage-7 L3 table covers GPU VA 0x1000000..0x11fffff, so these fall in
+	 * it. 0104 faulted (CB1 FSR 0x408, FAR 0x1030000 = the IB) because the
+	 * TLB was invalidated BEFORE the new PTEs were flushed to memory. Order
+	 * now: write PTEs -> flush the page tables (NC walks read RAM directly)
+	 * -> invalidate the TLB -> only then submit. */
+	uint64_t *l3 = (uint64_t *)(gpumem + 0x2000u);
+	const struct { uint64_t va; uint32_t off; } maps[] = {
+		{GVA_IB, GPUMEM_IB}, {GVA_SCRATCH, GPUMEM_SCRATCH}, {GVA_FENCE, GPUMEM_FENCE},
+	};
+	/* 0105: FSR 0x408 = format | PF (bit 3, PERMISSION fault, not a
+	 * translation fault), FAR = the IB. Commands in the ring run privileged
+	 * but an IB runs at the unprivileged level, and so do its CP_MEM_WRITEs:
+	 * the IB and scratch pages need AP[1] (EL0 access), as Linux maps user
+	 * BOs (no IOMMU_PRIV). The fence is written from the ring but is mapped
+	 * the same way for simplicity. */
+	for (unsigned i = 0; i < 3; ++i) {
+		l3[(maps[i].va >> 12) & 0x1ffu] = (gpumem_pa + maps[i].off) | PTE_AF | PTE_SH_OS |
+		    PTE_AP_UNPRIV | PTE_PAGE;
+	}
+	flush_dcache64((addr64_t)(gpumem + 0x2000u), 0x1000u, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (unsigned i = 0; i < 3; ++i) {
+		printf("SWEET GPU: map %#llx -> PTE %#llx\n", (unsigned long long)maps[i].va,
+		    (unsigned long long)l3[(maps[i].va >> 12) & 0x1ffu]);
+	}
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (smmu) {
+		wr(smmu, SMMU_CB1 + 0x618, 0);                /* TLBIALL */
+		wr(smmu, SMMU_CB1 + 0x7f0, 0);                /* TLBSYNC */
+		bool sync = wait_bits(smmu, SMMU_CB1 + 0x7f4, 1u, false, 1000);
+		wr(smmu, SMMU_CB1 + 0x058, rd(smmu, SMMU_CB1 + 0x058));  /* clear any stale FSR */
+		printf("SWEET GPU: CB1 TLB invalidate %s, FSR %#x\n", sync ? "ok" : "TIMEOUT",
+		    rd(smmu, SMMU_CB1 + 0x058));
+	}
+
+	volatile uint32_t *scratch = (volatile uint32_t *)(gpumem + GPUMEM_SCRATCH);
+	volatile uint32_t *fence = (volatile uint32_t *)(gpumem + GPUMEM_FENCE);
+	scratch[0] = 0;
+	scratch[1] = 0;
+	*fence = 0;
+	/*
+	 * 0122: these zeroes must reach RAM before the GPU writes there, and
+	 * the polls below must not read (or write back) cached copies. Until
+	 * now neither page was flushed here and the poll only covered scratch
+	 * (0x50000..0x51fff), not the fence at 0x60000: one boot (gl1) read
+	 * scratch right and the fence as 0 for 500 ms, and RedwoodGPU was not
+	 * published.
+	 */
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_SCRATCH), 0x1000u, FALSE);
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_FENCE), 0x1000u, FALSE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* IB body: two CP_MEM_WRITE (opcode 61, 3 dwords: addr_lo, addr_hi, val). */
+	uint32_t *ib = (uint32_t *)(gpumem + GPUMEM_IB);
+	unsigned n = 0;
+	ib[n++] = pkt7(61, 3);
+	ib[n++] = (uint32_t)GVA_SCRATCH;
+	ib[n++] = (uint32_t)(GVA_SCRATCH >> 32);
+	ib[n++] = 0xcafe0001u;
+	ib[n++] = pkt7(61, 3);
+	ib[n++] = (uint32_t)(GVA_SCRATCH + 4);
+	ib[n++] = (uint32_t)((GVA_SCRATCH + 4) >> 32);
+	ib[n++] = 0xcafe0002u;
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_IB), 0x1000u, FALSE);
+
+	/* Ring: CP_INDIRECT_BUFFER (63, 3) iova_lo/hi/size, then the fence. */
+	uint32_t *rb = (uint32_t *)(gpumem + GPUMEM_RB);
+	unsigned w = grd(gpu, 0x807);
+	rb[w++] = pkt7(63, 3);
+	rb[w++] = (uint32_t)GVA_IB;
+	rb[w++] = (uint32_t)(GVA_IB >> 32);
+	rb[w++] = n;
+	rb[w++] = pkt7(70, 4);                            /* CP_EVENT_WRITE */
+	/* 0106: the IB ran (both scratch words landed) but the fence word got
+	 * 0x2c1e74c3: the TIMESTAMP flag (bit 30) makes the CP store its own
+	 * counter sample, not our payload. Linux's submit fence is
+	 * EVENT(CACHE_FLUSH_TS) | IRQ (bit 31), which writes the payload. */
+	rb[w++] = 0x4u | 0x80000000u;                     /* CACHE_FLUSH_TS | IRQ */
+	rb[w++] = (uint32_t)GVA_FENCE;
+	rb[w++] = (uint32_t)(GVA_FENCE >> 32);
+	rb[w++] = 0xf00dface;                             /* fence value */
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_RB), RB_SIZE, FALSE);
+
+	gpu_checkpoint("about to submit the IB + fence");
+	gwr(gpu, 0x807, w);                               /* CP_RB_WPTR */
+	unsigned ms = 0;
+	uint32_t fv = 0, s0 = 0, s1 = 0;
+	for (; ms < 500; ++ms) {
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_SCRATCH), 0x1000u, FALSE);
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_FENCE), 0x1000u, FALSE);
+		fv = *fence;
+		s0 = scratch[0];
+		s1 = scratch[1];
+		if (fv == 0xf00dface) {
+			break;
+		}
+		if (grd(gpu, 0x823) || grd(gpu, 0x821)) {
+			break;
+		}
+		delay(1000);
+	}
+	bool ok = fv == 0xf00dface && s0 == 0xcafe0001u && s1 == 0xcafe0002u;
+	uint32_t int0 = grd(gpu, 0x201);
+	printf("SWEET GPU: RBBM_INT_0_STATUS %#x (CACHE_FLUSH_TS bit 0x100000 %s)\n", int0,
+	    (int0 & 0x100000u) ? "set: the fence IRQ fired" : "clear");
+	gwr(gpu, 0x0037, int0);                           /* RBBM_INT_CLEAR_CMD */
+	printf("SWEET GPU: IB %s after %u ms: scratch %#x %#x fence %#x (want cafe0001 cafe0002 f00dface)\n",
+	    ok ? "EXECUTED" : "did not complete", ms, s0, s1, fv);
+	gpu_cp_report(gpu, "after IB");
+	if (ok) {
+		printf("SWEET GPU: stage 10 done: the GPU ran an indirect buffer and signalled a fence\n");
+		printf("SWEET GPU: *** command path works end to end; ready for the Mesa user client ***\n");
+	}
+	return ok;
+}
+
+/*
+ * ===== Backend: the redwood_gpu_* interface for RedwoodGPU.cpp =====
+ *
+ * Same shape as ios-topaz's TopazAdreno.cpp (HackiOS, APSL 2.0), on our
+ * A640 bring-up: a GPU address-space allocator, CB1 page tables grown on
+ * demand, a ring with per-submission fence numbers written by
+ * CACHE_FLUSH_TS, and the 14 functions RedwoodGPU.cpp calls. Stages 1..10
+ * must have run (sweetgpu>=11 keeps the GPU up and publishes this). The
+ * fence memory is one page at GPU VA 0x01060000; the ring wraps.
+ */
+#define GVA_FENCEMEM      0x01060000ull
+#define GPUMEM_FENCEMEM   0x70000u
+#define GVA_USER_START    0x01100000ull    /* VA given to clients starts here */
+#define GVA_USER_END      0xf0000000ull
+#define RB_DWORDS         (RB_SIZE / 4u)
+
+/* Prototypes: RedwoodGPU.cpp calls these (extern "C"). */
+bool redwood_gpu_ready(void);
+bool redwood_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t redwood_gpu_address(uint64_t size);
+void redwood_gpu_address_free(uint64_t address, uint64_t size);
+bool redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void redwood_gpu_mapped(void);
+void redwood_gpu_unmap(uint64_t address, uint64_t size);
+void redwood_gpu_to_memory(void *start, uint64_t size);
+uint32_t redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool redwood_gpu_done(uint32_t fence);
+uint32_t redwood_gpu_last(void);
+void redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void redwood_gpu_report(const char *why);
+void redwood_gpu_stop(void);
+
+static vm_offset_t be_gpu, be_smmu;
+static uint32_t be_wptr, be_seqno;
+static volatile uint32_t *be_fence;
+static bool be_ready, be_tables_dirty;
+extern lck_mtx_t *gpu_be_lock;
+lck_mtx_t *gpu_be_lock;
+extern lck_grp_t *gpu_be_grp;
+lck_grp_t *gpu_be_grp;
+
+/* VA free list (merged on free), from darwin-redwood via topaz. */
+static struct { uint64_t start, size; } be_va[1024];
+static unsigned be_va_count;
+
+/* On-demand L2/L3 tables for CB1, carved from contiguous pages. */
+static uint64_t be_l3_pa[GVA_USER_END >> 21];      /* 0 = none; one L3 covers 2 MB */
+static vm_offset_t be_l3_kva[GVA_USER_END >> 21];  /* kernel VA of that L3 page */
+
+static uint64_t *
+be_l3_for(uint64_t va, bool create)
+{
+	/* All client VA lives in [0x1000000, 0xf0000000): one L1 entry (L1[0],
+	 * 0..1 GB) whose L2 is the stage-7 table at gpumem + 0x1000. Grow only
+	 * the L3 tables (one per 2 MB), carved as single contiguous pages. */
+	if (va < 0x200000ull || va >= GVA_USER_END) {
+		return NULL;                   /* below the IB/ring block or out of range */
+	}
+	unsigned slot = (unsigned)(va >> 21);
+	/* 0108 panicked here on the second page of a slot: the L3 pages are
+	 * separate allocations, not inside gpumem, so "pa - gpumem_pa + gpumem"
+	 * was a wild pointer (data abort, FAR = that + 8 * index). Keep the VA. */
+	if (be_l3_pa[slot]) {
+		return (uint64_t *)be_l3_kva[slot];
+	}
+	if (!create) {
+		return NULL;
+	}
+	vm_offset_t kva;
+	if (kmem_alloc_contig(kernel_map, &kva, 0x1000u, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (!pn) {
+		return NULL;
+	}
+	uint64_t pa = ptoa_64(pn);
+	uint64_t *l2 = (uint64_t *)(gpumem + 0x1000u);     /* stage-7 L2 (L1[0]) */
+	l2[(va >> 21) & 0x1ffu] = pa | PTE_TABLE;
+	be_l3_pa[slot] = pa;
+	be_l3_kva[slot] = kva;
+	flush_dcache64((addr64_t)(gpumem + 0x1000u), 0x1000u, FALSE);
+	return (uint64_t *)kva;
+}
+
+bool
+redwood_gpu_ready(void)
+{
+	return be_ready;
+}
+
+bool
+redwood_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01: *value = 640; return true;                       /* GPU_ID */
+	case 0x02: *value = 0x100000; return true;                  /* GMEM_SIZE (1 MiB) */
+	case 0x03: *value = A640_CHIPID; return true;               /* CHIP_ID */
+	case 0x04: *value = 585000000ull; return true;              /* MAX_FREQ */
+	case 0x05:                                                  /* TIMESTAMP: CP always-on */
+		*value = be_ready ? (((uint64_t)grd((vm_offset_t)be_gpu, 0x981) << 32) |
+		    grd((vm_offset_t)be_gpu, 0x980)) : 0;
+		return true;
+	case 0x06: *value = 0x100000; return true;                  /* GMEM_BASE */
+	case 0x07: *value = 1; return true;                         /* PRIORITIES */
+	case 0x10: *value = 15; return true;                        /* HIGHEST_BANK_BIT (a640) */
+	case 0x12: *value = 6; return true;                         /* UBWC_SWIZZLE */
+	case 0x08: case 0x09: case 0x0a: case 0x11: case 0x13:
+		*value = 0;
+		return true;
+	default:
+		return false;
+	}
+}
+
+uint64_t
+redwood_gpu_address(uint64_t size)
+{
+	size = (size + 0xffffull) & ~0xffffull;
+	for (unsigned i = 0; i < be_va_count; i++) {
+		if (be_va[i].size >= size) {
+			uint64_t a = be_va[i].start;
+			be_va[i].start += size;
+			be_va[i].size -= size;
+			if (be_va[i].size == 0) {
+				memmove(&be_va[i], &be_va[i + 1], (--be_va_count - i) * sizeof(be_va[0]));
+			}
+			return a;
+		}
+	}
+	return 0;
+}
+
+void
+redwood_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+	size = (size + 0xffffull) & ~0xffffull;
+	for (at = 0; at < be_va_count && be_va[at].start < address; at++) {
+	}
+	if (at > 0 && be_va[at - 1].start + be_va[at - 1].size == address) {
+		be_va[at - 1].size += size;
+		if (at < be_va_count && address + size == be_va[at].start) {
+			be_va[at - 1].size += be_va[at].size;
+			memmove(&be_va[at], &be_va[at + 1], (--be_va_count - at) * sizeof(be_va[0]));
+		}
+	} else if (at < be_va_count && address + size == be_va[at].start) {
+		be_va[at].start = address;
+		be_va[at].size += size;
+	} else if (be_va_count < 1024) {
+		memmove(&be_va[at + 1], &be_va[at], (be_va_count++ - at) * sizeof(be_va[0]));
+		be_va[at].start = address;
+		be_va[at].size = size;
+	}
+}
+
+bool
+redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	uint64_t *t = be_l3_for(address, true);
+	if (t == NULL) {
+		return false;
+	}
+	t[(address >> 12) & 0x1ffu] = (phys & ~0xfffull) | PTE_AF | PTE_SH_OS | PTE_AP_UNPRIV |
+	    (read_only ? PTE_AP_RO : 0) | PTE_PAGE;
+	be_tables_dirty = true;
+	return true;
+}
+
+static void
+be_tlb_flush(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(be_smmu, SMMU_CB1 + 0x618, 0);
+	wr(be_smmu, SMMU_CB1 + 0x7f0, 0);
+	wait_bits(be_smmu, SMMU_CB1 + 0x7f4, 1u, false, 1000);
+}
+
+void
+redwood_gpu_mapped(void)
+{
+	if (be_tables_dirty) {
+		be_tables_dirty = false;
+		for (unsigned s = 0; s < (GVA_USER_END >> 21); s++) {
+			if (be_l3_pa[s]) {
+				flush_dcache64((addr64_t)be_l3_kva[s], 0x1000u, FALSE);
+			}
+		}
+		be_tlb_flush();
+	}
+}
+
+void
+redwood_gpu_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 0x1000ull) {
+		uint64_t *t = be_l3_for(address + off, false);
+		if (t != NULL) {
+			t[((address + off) >> 12) & 0x1ffu] = 0;
+		}
+	}
+	be_tlb_flush();
+}
+
+void
+redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		flush_dcache64((addr64_t)start, (unsigned)size, FALSE);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint32_t
+be_ring_free(void)
+{
+	uint32_t r = grd((vm_offset_t)be_gpu, 0x806), w = be_wptr % RB_DWORDS;
+	return (r + RB_DWORDS - w - 1) % RB_DWORDS;
+}
+
+static void
+be_emit(uint32_t v)
+{
+	((volatile uint32_t *)(gpumem + GPUMEM_RB))[be_wptr % RB_DWORDS] = v;
+	be_wptr++;
+}
+
+uint32_t
+redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	if (!be_ready || count == 0) {
+		return 0;
+	}
+	uint32_t need = 4u * count + 5u;
+	lck_mtx_lock(gpu_be_lock);
+	for (int spin = 0; be_ring_free() < need && spin < 20000; spin++) {
+		delay(100);
+	}
+	if (be_ring_free() < need) {
+		lck_mtx_unlock(gpu_be_lock);
+		return 0;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		be_emit(pkt7(63, 3));
+		be_emit((uint32_t)addresses[i]);
+		be_emit((uint32_t)(addresses[i] >> 32));
+		be_emit(words[i]);
+	}
+	if (++be_seqno == 0) {
+		be_seqno = 1;
+	}
+	uint32_t fence = be_seqno;
+	be_emit(pkt7(70, 4));
+	be_emit(0x4u | 0x80000000u);                   /* CACHE_FLUSH_TS | IRQ */
+	be_emit((uint32_t)GVA_FENCEMEM);
+	be_emit((uint32_t)(GVA_FENCEMEM >> 32));
+	be_emit(fence);
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_RB), RB_SIZE, FALSE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr((vm_offset_t)be_gpu, 0x807, be_wptr % RB_DWORDS);
+	lck_mtx_unlock(gpu_be_lock);
+	return fence;
+}
+
+bool
+redwood_gpu_done(uint32_t fence)
+{
+	if (be_fence == NULL) {
+		return true;
+	}
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_FENCEMEM), 0x1000u, FALSE);
+	return (int32_t)(*be_fence - fence) >= 0;
+}
+
+uint32_t
+redwood_gpu_last(void)
+{
+	return be_seqno;
+}
+
+void
+redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = be_seqno;
+	bzero(by, 7 * sizeof(uint32_t));
+}
+
+void
+redwood_gpu_report(const char *why)
+{
+	if (be_fence) {
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_FENCEMEM), 0x1000u, FALSE);
+	}
+	printf("SWEET GPU: report %s: fence seq %u done %u rptr %#x wptr %#x RBBM %#x CP_INT %#x CP_HW_FAULT %#x\n",
+	    why, be_seqno, be_fence ? *be_fence : 0, grd((vm_offset_t)be_gpu, 0x806),
+	    be_wptr % RB_DWORDS, grd((vm_offset_t)be_gpu, 0x210), grd((vm_offset_t)be_gpu, 0x823),
+	    grd((vm_offset_t)be_gpu, 0x821));
+	if (be_smmu) {
+		printf("SWEET GPU: report %s: smmu CB1 FSR %#x FSYNR0 %#x FAR %#llx\n", why,
+		    rd(be_smmu, SMMU_CB1 + 0x058), rd(be_smmu, SMMU_CB1 + 0x068),
+		    (unsigned long long)rd64(be_smmu, SMMU_CB1 + 0x060));
+	}
+}
+
+void
+redwood_gpu_stop(void)
+{
+	if (be_ready) {
+		gwr((vm_offset_t)be_gpu, 0x808, 0);
+	}
+	be_ready = false;
+}
+
+/* Real one arrives with RedwoodGPU.cpp (0109); weak stub so 0108 links and
+ * the backend self-test can run on its own. */
+__attribute__((weak)) void RedwoodGPUStart(void);
+__attribute__((weak)) void
+RedwoodGPUStart(void)
+{
+	printf("SWEET GPU: RedwoodGPUStart stub (user client not built yet)\n");
+}
+
+/* Turn the finished stage-10 state into the running backend. */
+static void
+gpu_backend_start(void)
+{
+	be_gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	be_smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	be_wptr = grd((vm_offset_t)be_gpu, 0x807);
+	be_seqno = 0;
+	/* fence page at GVA_FENCEMEM */
+	uint64_t *l3 = (uint64_t *)(gpumem + 0x2000u);
+	l3[(GVA_FENCEMEM >> 12) & 0x1ffu] = (gpumem_pa + GPUMEM_FENCEMEM) | PTE_AF | PTE_SH_OS |
+	    PTE_AP_UNPRIV | PTE_PAGE;
+	be_fence = (volatile uint32_t *)(gpumem + GPUMEM_FENCEMEM);
+	*be_fence = 0;
+	/* 0122: flush after the zero, or redwood_gpu_done()'s first clean +
+	 * invalidate could write a stale 0 over the GPU's first fence. */
+	flush_dcache64((addr64_t)gpumem, GPUMEM_SIZE, FALSE);
+	/* 0109: the self-test IB at 0x1100000 shares 2 MB slot 8 with the
+	 * stage-7 kernel block (0x1000000..: SQE, ring, shadow, IB test, fence).
+	 * be_l3_for() saw no L3 recorded for slot 8, allocated a fresh one and
+	 * pointed L2[8] at it: the ring, the fence page and the SQE vanished
+	 * from the GPU's view (fence never landed, RBBM busy 0x800005).
+	 * Register the existing stage-7 L3 table for slot 8 first. */
+	be_l3_pa[GVA_SQE >> 21] = gpumem_pa + 0x2000u;
+	be_l3_kva[GVA_SQE >> 21] = gpumem + 0x2000u;
+	be_va_count = 0;
+	redwood_gpu_address_free(GVA_USER_START, GVA_USER_END - GVA_USER_START);
+	gpu_be_grp = lck_grp_alloc_init("sweet-gpu", LCK_GRP_ATTR_NULL);
+	gpu_be_lock = lck_mtx_alloc_init(gpu_be_grp, LCK_ATTR_NULL);
+	be_ready = true;
+	be_tlb_flush();
+
+	/* smoke test through the backend: a client-style IB that writes a word */
+	uint64_t va = redwood_gpu_address(0x2000);
+	vm_offset_t kva;
+	kmem_alloc_contig(kernel_map, &kva, 0x2000u, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)kva));
+	redwood_gpu_map(va, pa, false);
+	redwood_gpu_map(va + 0x1000, pa + 0x1000, false);
+	redwood_gpu_mapped();
+	uint32_t *ib = (uint32_t *)kva;            /* IB at va */
+	volatile uint32_t *out = (volatile uint32_t *)(kva + 0x1000); /* scratch at va+0x1000 */
+	unsigned n = 0;
+	ib[n++] = pkt7(61, 3);
+	ib[n++] = (uint32_t)(va + 0x1000);
+	ib[n++] = (uint32_t)((va + 0x1000) >> 32);
+	ib[n++] = 0xbeef6400u;
+	*out = 0;
+	redwood_gpu_to_memory((void *)kva, 0x2000);
+	uint64_t ibaddr = va;
+	uint32_t f = redwood_gpu_submit(&ibaddr, &n, 1);
+	unsigned ms = 0;
+	for (; ms < 500 && !redwood_gpu_done(f); ms++) {
+		delay(1000);
+	}
+	flush_dcache64((addr64_t)kva, 0x2000u, FALSE);
+	printf("SWEET GPU: backend self-test: fence %u done=%d out %#x (want beef6400), last %u\n",
+	    f, redwood_gpu_done(f), *out, redwood_gpu_last());
+	redwood_gpu_report("backend ready");
+	RedwoodGPUStart();
+	printf("SWEET GPU: *** Adreno 640 backend published (RedwoodGPU) ***\n");
+}
+
+
+static unsigned gpu_stage;
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 60;
+	(void)arg;
+	(void)result;
+	/* After root mount, the lock screen and the touch driver (45 s). */
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	printf("SWEET GPU: Adreno 640 stage 1 (read-only) in %u s\n", delay_s);
+	gpu_wait_ms(delay_s * 1000u);
+
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	vm_offset_t gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	vm_offset_t qfprom = ml_io_map(QFPROM_PA, QFPROM_SIZE);
+	if (!gcc || !gpucc || !qfprom) {
+		printf("SWEET GPU: MMIO mapping failed\n");
+		goto out;
+	}
+
+	uint32_t vote = rd(gcc, 0x52004);
+	printf("SWEET GPU: gcc vote 0x52004=%#x (gpll0 %u gpll0_div %u)\n", vote,
+	    (vote >> 15) & 1u, (vote >> 16) & 1u);
+	for (unsigned i = 0; i < sizeof(gcc_regs) / sizeof(gcc_regs[0]); ++i) {
+		uint32_t v = rd(gcc, gcc_regs[i].off);
+		printf("SWEET GPU: gcc %-16s %#x = %#010x (%s)\n", gcc_regs[i].name,
+		    gcc_regs[i].off, v, (v & CBCR_CLK_OFF) ? "off" : "on");
+	}
+
+	uint32_t cx = rd(gpucc, 0x106c), cxhw = rd(gpucc, 0x1540), gx = rd(gpucc, 0x100c);
+	printf("SWEET GPU: gdsc cx %#010x (%s) hw-ctrl %#x, gx %#010x (%s)\n",
+	    cx, (cx & GDSC_PWR_ON) ? "on" : "off", cxhw, gx, (gx & GDSC_PWR_ON) ? "on" : "off");
+	uint32_t rcg = rd(gpucc, 0x1120), rcgcfg = rd(gpucc, 0x1124);
+	printf("SWEET GPU: gmu rcg cmd %#x cfg %#x (src %u div %u)\n", rcg, rcgcfg,
+	    (rcgcfg >> 8) & 7u, rcgcfg & 0x1fu);
+	for (unsigned i = 0; i < sizeof(gpucc_cbcrs) / sizeof(gpucc_cbcrs[0]); ++i) {
+		uint32_t v = rd(gpucc, gpucc_cbcrs[i].off);
+		printf("SWEET GPU: gpucc %-12s %#x = %#010x (%s)\n", gpucc_cbcrs[i].name,
+		    gpucc_cbcrs[i].off, v, (v & CBCR_CLK_OFF) ? "off" : "on");
+	}
+
+	uint32_t fuse = rd(qfprom, SPEED_BIN_OFF);
+	printf("SWEET GPU: qfprom %#x = %#x, speed bin %u\n", QFPROM_PA + SPEED_BIN_OFF,
+	    fuse, (fuse & 0xe0000000u) >> 29);
+
+	if (!(cx & GDSC_PWR_ON)) {
+		printf("SWEET GPU: CX domain off: GMU/GPU SMMU not read (expected after ABL)\n");
+	} else {
+		printf("SWEET GPU: CX domain on after ABL: GMU state is read in stage 2\n");
+	}
+	gpu_fw_report();
+	printf("SWEET GPU: stage 1 done\n");
+	if (gpu_stage >= 2 && gpu_stage2(gcc, gpucc) && gpu_stage >= 3 && gpu_stage3() &&
+	    gpu_stage >= 4 && gpu_stage4() && gpu_stage >= 5 && gpu_stage5() && gpu_stage >= 6 &&
+	    gpu_stage6() && gpu_stage >= 7 && gpu_stage7() && gpu_stage >= 8 && gpu_stage8() &&
+	    gpu_stage >= 9 && gpu_stage9() && gpu_stage >= 10 && gpu_stage10() &&
+	    gpu_stage >= 11) {
+		gpu_backend_start();
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_probe(void)
+{
+	unsigned stage = 0;
+	(void)PE_parse_boot_argn("sweetgpu", &stage, sizeof(stage));
+	gpu_stage = stage;
+	if (stage == 0) {
+		printf("SWEET GPU: disabled (sweetgpu=0)\n");
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET GPU: thread start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
