+#define GCC_PA            0x00100000u
+#define GCC_SIZE          0x00090000u
+#define GPUCC_PA          0x02c90000u
+#define GPUCC_SIZE        0x00009000u
+#define QFPROM_PA         0x00780000u
+#define QFPROM_SIZE       0x00007000u
+#define SPEED_BIN_OFF     0x4130u
+
+#define GMU_PA            0x02c6a000u
+#define GMU_SIZE          0x00030000u
+#define SMMU_PA           0x02ca0000u
+#define SMMU_SIZE         0x00010000u
+/* GMU registers: Linux a6xx_gmu.xml.h dword numbers, byte offset = n * 4
+ * from the GMU block (KGSL numbers them from the GPU base: n*4 - 0x6a000). */
+#define GMU_ITCM          (0x0c00u * 4)  /* CM3_ITCM_START, 16 KiB */
+#define GMU_DTCM          (0x1c00u * 4)  /* CM3_DTCM_START, 16 KiB */
+#define GMU_FW_INIT       (0x501cu * 4)  /* CM3_FW_INIT_RESULT (0090-0092 read 0x1cfa*4: wrong) */
+#define GMU_SYSRESET      (0x5000u * 4)  /* CM3_SYSRESET: 1 = held in reset */
+#define CBCR_CLK_OFF      (1u << 31)
+#define GDSC_PWR_ON       (1u << 31)
