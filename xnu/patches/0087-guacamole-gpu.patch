+/*
+ * MMIO through explicit single-register LDR/STR with a base-only address:
+ * always a valid ISS syndrome (ISV=1) if the access traps to a hypervisor
+ * that emulates it (Qualcomm's QHEE does this for SMMU stage-2 state). A
+ * plain volatile access may compile to post-indexed or paired forms in a
+ * loop, which a trapping hypervisor cannot decode.
+ */
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+	volatile uint32_t *p = (volatile uint32_t *)(base + off);
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(p) : "memory");
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	assert_wait_deadline((event_t)&gpu_wait_ms, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_fw_report(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	for (unsigned i = 0; i < sizeof(gpu_fw) / sizeof(gpu_fw[0]); ++i) {
+		vnode_t vp = NULLVP;
+		int err = vnode_lookup(gpu_fw[i], 0, &vp, ctx);
+		if (err) {
+			printf("SWEET GPU: fw %s: missing (%d)\n", gpu_fw[i], err);
+			continue;
+		}
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		err = vnode_getattr(vp, &va, ctx);
+		printf("SWEET GPU: fw %s: %llu bytes (%d)\n", gpu_fw[i],
+		    err ? 0ULL : (unsigned long long)va.va_data_size, err);
+		vnode_put(vp);
+	}
+}
+
+
+static bool
+wait_bits(vm_offset_t base, uint32_t off, uint32_t mask, bool set, unsigned us)
+{
+	for (unsigned i = 0; i < us; ++i) {
+		uint32_t v = rd(base, off);
+		if (set ? (v & mask) == mask : (v & mask) == 0) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	volatile uint32_t *p = (volatile uint32_t *)(base + off);
+	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"(p) : "memory");
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+branch_on(vm_offset_t base, uint32_t off, const char *name, bool poll)
+{
+	wr(base, off, rd(base, off) | 1u);
+	bool ok = !poll || wait_bits(base, off, CBCR_CLK_OFF, false, 200);
+	printf("SWEET GPU: enable %-16s %#x = %#010x%s\n", name, off, rd(base, off),
+	    ok ? "" : " (still off)");
+	return ok;
+}
+
+/* With boot-arg ufslogsecs=1 the persistent log flushes every second: a
+ * pause before a risky access keeps the last line if the access hangs. */
+static void
+gpu_checkpoint(const char *what)
+{
+	printf("SWEET GPU: checkpoint: %s\n", what);
+	gpu_wait_ms(2500);
+}
+
+static void
+gpu_smmu_dump(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!smmu) {
+		printf("SWEET GPU: SMMU map failed\n");
+		return;
+	}
+	uint32_t cr0 = rd(smmu, 0x0), idr0 = rd(smmu, 0x20), idr1 = rd(smmu, 0x24);
+	unsigned nsmr = idr0 & 0xffu;
+	unsigned pgshift = (idr1 & (1u << 31)) ? 16 : 12;
+	unsigned numpage = 1u << (((idr1 >> 28) & 7u) + 1);
+	unsigned ncb = idr1 & 0xffu;
+	uint32_t cbbase = numpage << pgshift;
+	printf("SWEET GPU: smmu sCR0 %#x IDR0 %#x IDR1 %#x: %u SMRs, %u CBs at +%#x\n",
+	    cr0, idr0, idr1, nsmr, ncb, cbbase);
+	printf("SWEET GPU: smmu sGFSR %#x sGFSYNR0 %#x sGFAR %#x\n",
+	    rd(smmu, 0x48), rd(smmu, 0x50), rd(smmu, 0x40));
+	if (cbbase + 0x1000u <= SMMU_SIZE) {
+		gpu_checkpoint("about to read context bank 0");
+		printf("SWEET GPU: smmu CB0 SCTLR %#x TTBR0 %#x FSR %#x\n",
+		    rd(smmu, cbbase + 0x0), rd(smmu, cbbase + 0x20), rd(smmu, cbbase + 0x58));
+	}
+	gpu_checkpoint("about to read SMR0 (one LDR)");
+	printf("SWEET GPU: smmu SMR0 %#010x\n", rd(smmu, 0x800));
+	gpu_checkpoint("SMR0 read survived; about to read S2CR0");
+	printf("SWEET GPU: smmu S2CR0 %#010x\n", rd(smmu, 0xc00));
+	for (unsigned i = 1; i < nsmr && i < 16; ++i) {
+		printf("SWEET GPU: smmu SMR%u %#010x S2CR%u %#010x\n", i,
+		    rd(smmu, 0x800 + 4 * i), i, rd(smmu, 0xc00 + 4 * i));
+	}
+}
+
+static bool
+gpu_stage2(vm_offset_t gcc, vm_offset_t gpucc)
+{
+	printf("SWEET GPU: stage 2: CX domain + GMU clocks\n");
+	wr(gcc, 0x52004, rd(gcc, 0x52004) | (1u << 15) | (1u << 16)); /* gpll0, gpll0_div */
+	printf("SWEET GPU: gcc vote 0x52004=%#x\n", rd(gcc, 0x52004));
+
+	/* CX GDSC first: the GPU-side branches (snoc_dvm_gfx, gpucc cx_*) only
+	 * report running once their domain is powered (v1 enabled snoc_dvm_gfx
+	 * before CX and it stayed "off"). */
+	wr(gpucc, 0x106c, rd(gpucc, 0x106c) & ~1u);
+	bool cx = wait_bits(gpucc, 0x106c, GDSC_PWR_ON, true, 2000);
+	printf("SWEET GPU: CX GDSC %s: gdscr %#010x hw-ctrl %#010x\n", cx ? "on" : "TIMEOUT",
+	    rd(gpucc, 0x106c), rd(gpucc, 0x1540));
+	if (!cx) {
+		return false;
+	}
+	branch_on(gcc, 0x7100c, "gpu_memnoc_gfx", false);   /* BRANCH_VOTED */
+	branch_on(gcc, 0x71018, "gpu_snoc_dvm_gfx", true);
+	branch_on(gcc, 0x71154, "ddrss_gpu_axi", false);    /* BRANCH_VOTED */
+
+	/* GMU RCG: GPLL0_OUT_MAIN_DIV (source 6) / 1.5 (HID 2) = 200 MHz. */
+	wr(gpucc, 0x1124, (6u << 8) | 2u);
+	wr(gpucc, 0x1120, rd(gpucc, 0x1120) | 1u);
+	bool upd = wait_bits(gpucc, 0x1120, 1u, false, 500);
+	printf("SWEET GPU: GMU RCG 200 MHz %s: cmd %#x cfg %#x\n", upd ? "set" : "UPDATE TIMEOUT",
+	    rd(gpucc, 0x1120), rd(gpucc, 0x1124));
+	if (!upd) {
+		return false;
+	}
+	bool ok = branch_on(gpucc, 0x1078, "gpucc ahb", true);
+	ok &= branch_on(gpucc, 0x109c, "gpucc cxo", true);
+	ok &= branch_on(gpucc, 0x1098, "gpucc cx_gmu", true);
+	branch_on(gpucc, 0x108c, "gpucc cx_snoc_dvm", true);
+	branch_on(gpucc, 0x1088, "gpucc cx_apb", true);
+	printf("SWEET GPU: GMU RCG after enable: cmd %#x (root %s)\n", rd(gpucc, 0x1120),
+	    (rd(gpucc, 0x1120) & (1u << 31)) ? "off" : "on");
+	if (!ok) {
+		printf("SWEET GPU: GMU interface clocks not running: GMU not read\n");
+		return false;
+	}
+
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	if (!gmu) {
+		printf("SWEET GPU: GMU map failed\n");
+		return false;
+	}
+	uint32_t rst = rd(gmu, GMU_SYSRESET);
+	printf("SWEET GPU: GMU CM3_SYSRESET %#x (1 = in reset) FW_INIT_RESULT %#x\n",
+	    rst, rd(gmu, GMU_FW_INIT));
+	if (rst != 1) {
+		printf("SWEET GPU: GMU core not held in reset: TCMs not touched\n");
+	} else {
+		const uint32_t pat[2] = {0x5a5aa5a5u, 0xc0ffee11u};
+		const uint32_t tcm[2] = {GMU_ITCM, GMU_DTCM};
+		for (unsigned i = 0; i < 2; ++i) {
+			uint32_t old = rd(gmu, tcm[i]);
+			wr(gmu, tcm[i], pat[i]);
+			uint32_t back = rd(gmu, tcm[i]);
+			wr(gmu, tcm[i], old);
+			printf("SWEET GPU: %s write %#x read %#x: %s\n", i ? "DTCM" : "ITCM",
+			    pat[i], back, back == pat[i] ? "ok" : "MISMATCH");
+		}
+	}
+	uint32_t snoc = rd(gcc, 0x71018), apb = rd(gpucc, 0x1088);
+	printf("SWEET GPU: recheck gpu_snoc_dvm_gfx %#010x (%s), gpucc cx_apb %#010x (%s)\n",
+	    snoc, (snoc & CBCR_CLK_OFF) ? "off" : "on", apb, (apb & CBCR_CLK_OFF) ? "off" : "on");
+	if (snoc & CBCR_CLK_OFF) {
+		/* v1 crashed (CrashDump) right after reading the SMMU ID registers,
+		 * with snoc_dvm_gfx (an SMMU clock in the live DT) still off. */
+		printf("SWEET GPU: SMMU clock snoc_dvm_gfx off: SMMU not read\n");
+	} else {
+		gpu_checkpoint("about to read the GPU SMMU");
+		gpu_smmu_dump();
+	}
+	printf("SWEET GPU: stage 2 done (CX and GMU clocks left on, GMU in reset)\n");
+	return rst == 1;
+}
+
+/*
+ * ===== Stage 3: GMU memory + GPU SMMU context for the GMU (no GMU boot) =====
+ *
+ * The A640 GMU firmware is in Linux's block format (a640_gmu.bin, ADT
+ * /sweet-gpu gmu-firmware): blocks for ITCM (0x0, 16 KiB) and DTCM
+ * (0x40000, 16 KiB) plus blocks for "icache" (GMU VA 0x4000, 256K-16K) and
+ * "dcache" (VA 0x44000, 256K-16K) in DDR (Linux a6xx_gmu.c allocates these
+ * for the a640 family). So, unlike the A618 (raw image, TCM only), the GMU
+ * reaches DDR through the GPU SMMU from its first instruction: the SMMU
+ * context must exist before it is released from reset (stage 4).
+ *
+ * Memory: one physically contiguous, cacheable 1 MiB block; the CPU writes
+ * it and cleans it to PoC; the SMMU walks NC tables and the PTEs map the
+ * pages Normal-NC, so the GMU sees DDR directly. (VM_WIMG_WCOMB via
+ * pmap_set_cache_attributes is avoided: on this kernel its cache flush
+ * truncates PAs above 4 GiB, see mxtpasontop's 0083.)
+ * SMMU (ARM SMMU-500, 4 KiB pages, CBs at +0x8000): CB0, AArch64 stage 1
+ * with stage 2 bypass, 32-bit VA, 3-level 4 KiB tables; exact SMRs for the
+ * GMU stream IDs 4/5 (DT gmu_user/gmu_kernel, iommus mask 0x400, so also
+ * 0x404/0x405) -> CB0. Masked SMRs did not stick on SM7150 (mxtpasontop).
+ * All register numbers: ARM SMMUv2 architecture; layout: live DT + Linux.
+ */
+#define GMEM_SIZE        0x100000u
+#define GMEM_PT          0x00000u   /* L1, L2a, L2b, L3a, L3b, L3c (4 KiB each) */
+#define GMEM_ICACHE      0x10000u   /* GMU VA 0x4000,  0x3c000 */
+#define GMEM_DCACHE      0x50000u   /* GMU VA 0x44000, 0x3c000 */
+#define GMEM_HFI         0x90000u   /* GMU VA 0x60100000, 16 KiB */
+#define GMEM_DUMMY       0x98000u   /* GMU VA 0x60000000, 4 KiB */
+#define GMEM_DEBUG       0x9c000u   /* GMU VA 0x60200000, 16 KiB */
+#define GMEM_LOG         0xa0000u   /* GMU VA 0x60300000, 16 KiB */
+#define GVA_ICACHE       0x00004000u
+#define GVA_DCACHE       0x00044000u
+#define GVA_DUMMY        0x60000000u
+#define GVA_HFI          0x60100000u
+#define GVA_DEBUG        0x60200000u
+#define GVA_LOG          0x60300000u
+#define CACHE_SIZE       0x3c000u
+
+#define PTE_TABLE        3ull
+#define PTE_PAGE         3ull
+#define PTE_AF           (1ull << 10)
+#define PTE_SH_OS        (2ull << 8)
+#define PTE_AP_UNPRIV    (1ull << 6)   /* EL0+EL1 RW; absent = privileged only */
+
+static vm_offset_t gmem;      /* kernel VA of the block */
+static uint64_t gmem_pa;
+
+static inline void
+wr64(vm_offset_t base, uint32_t off, uint64_t v)
+{
+	volatile uint64_t *p = (volatile uint64_t *)(base + off);
+	__asm__ volatile ("str %x0, [%1]" : : "r"(v), "r"(p) : "memory");
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint64_t
+rd64(vm_offset_t base, uint32_t off)
+{
+	uint64_t v;
+	volatile uint64_t *p = (volatile uint64_t *)(base + off);
+	__asm__ volatile ("ldr %x0, [%1]" : "=r"(v) : "r"(p) : "memory");
+	return v;
+}
+
+static uint64_t *
+pt(unsigned idx)
+{
+	return (uint64_t *)(gmem + GMEM_PT + idx * 0x1000u);
+}
+
+static uint64_t
+pt_pa(unsigned idx)
+{
+	return gmem_pa + GMEM_PT + idx * 0x1000u;
+}
+
+/* Map [va, va+len) -> gmem offset off, 4 KiB pages, in the L3 table l3. */
+static void
+pt_map(unsigned l3, uint32_t va, uint32_t off, uint32_t len, bool priv)
+{
+	uint64_t *t = pt(l3);
+	for (uint32_t o = 0; o < len; o += 0x1000u) {
+		unsigned i = ((va + o) >> 12) & 0x1ffu;
+		t[i] = (gmem_pa + off + o) | PTE_AF | PTE_SH_OS | (priv ? 0 : PTE_AP_UNPRIV) | PTE_PAGE;
+	}
+}
+
+static bool
+gpu_gmem_setup(void)
+{
+	if (gmem == 0) {
+		vm_offset_t kva;
+		if (kmem_alloc_contig(kernel_map, &kva, GMEM_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET GPU: no contiguous GMU memory\n");
+			return false;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+		if (!pn) {
+			printf("SWEET GPU: GMU memory has no physical page\n");
+			return false;
+		}
+		gmem = kva;
+		gmem_pa = ptoa_64(pn);
+	}
+	/* Tables: L1[0] -> L2a (0..1G), L1[1] -> L2b (1G..2G);
+	 * L2a[0] -> L3a (0..2M); L2b[256] -> L3b (0x60000000..), L2b[257] -> L3c. */
+	bzero(pt(0), 6 * 0x1000u);
+	pt(0)[0] = pt_pa(1) | PTE_TABLE;
+	pt(0)[1] = pt_pa(2) | PTE_TABLE;
+	pt(1)[0] = pt_pa(3) | PTE_TABLE;
+	pt(2)[256] = pt_pa(4) | PTE_TABLE;
+	pt(2)[257] = pt_pa(5) | PTE_TABLE;
+	pt_map(3, GVA_ICACHE, GMEM_ICACHE, CACHE_SIZE, true);   /* Linux: IOMMU_PRIV */
+	pt_map(3, GVA_DCACHE, GMEM_DCACHE, CACHE_SIZE, true);
+	pt_map(4, GVA_DUMMY, GMEM_DUMMY, 0x1000u, false);
+	pt_map(4, GVA_HFI, GMEM_HFI, 0x4000u, false);
+	pt_map(5, GVA_DEBUG, GMEM_DEBUG, 0x4000u, false);
+	pt_map(5, GVA_LOG, GMEM_LOG, 0x4000u, false);
+	flush_dcache64((addr64_t)gmem, GMEM_SIZE, FALSE);
+	printf("SWEET GPU: GMU memory %#llx (+%#x), tables at %#llx\n", (unsigned long long)gmem_pa,
+	    GMEM_SIZE, (unsigned long long)pt_pa(0));
+	return true;
+}
+
+/* Firmware from ADT /sweet-gpu: report blocks, copy the DDR ones. */
+static const uint32_t *gmu_fw;
+static unsigned gmu_fw_size;
+
+static bool
+gpu_fw_blocks(bool copy)
+{
+	DTEntry node;
+	const void *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "gmu-firmware", &prop, &size) != kSuccess) {
+		printf("SWEET GPU: no /sweet-gpu gmu-firmware in the ADT\n");
+		return false;
+	}
+	gmu_fw = (const uint32_t *)prop;
+	gmu_fw_size = size;
+	unsigned nblk = 0, bad = 0;
+	for (unsigned o = 0; o + 16u <= size; ) {
+		const uint32_t *b = (const uint32_t *)((uintptr_t)prop + o);
+		uint32_t addr = b[0], len = b[1];
+		const char *where = "?";
+		if (len & 3u || o + 16u + len > size) {
+			printf("SWEET GPU: fw block at %#x: bad size %#x\n", o, len);
+			return false;
+		}
+		if (addr < 0x4000u && addr + len <= 0x4000u) {
+			where = "ITCM";
+		} else if (addr >= 0x40000u && addr + len <= 0x44000u) {
+			where = "DTCM";
+		} else if (addr >= GVA_ICACHE && addr + len <= GVA_ICACHE + CACHE_SIZE) {
+			where = "icache";
+			if (copy) {
+				memcpy((void *)(gmem + GMEM_ICACHE + (addr - GVA_ICACHE)), &b[4], len);
+			}
+		} else if (addr >= GVA_DCACHE && addr + len <= GVA_DCACHE + CACHE_SIZE) {
+			where = "dcache";
+			if (copy) {
+				memcpy((void *)(gmem + GMEM_DCACHE + (addr - GVA_DCACHE)), &b[4], len);
+			}
+		} else {
+			bad++;
+		}
+		printf("SWEET GPU: fw block %u addr %#x size %#x -> %s\n", nblk, addr, len, where);
+		nblk++;
+		o += 16u + len;
+	}
+	if (copy) {
+		flush_dcache64((addr64_t)gmem, GMEM_SIZE, FALSE);
+	}
+	printf("SWEET GPU: gmu firmware %u bytes, %u blocks, %u unplaced\n", size, nblk, bad);
+	return bad == 0;
+}
+
+/* SMMU: GR0 page 0, GR1 page 1, CB n at 0x8000 + n * 0x1000 (4 KiB pages). */
+#define SMMU_GR1         0x1000u
+#define SMMU_CB0         0x8000u
+static const uint32_t gmu_sids[4] = {0x004u, 0x005u, 0x404u, 0x405u};
+
+static bool
+gpu_smmu_gmu_context(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!smmu) {
+		return false;
+	}
+	/* CB0: disable while (re)programming. */
+	wr(smmu, SMMU_CB0 + 0x000, 0);
+	wr(smmu, SMMU_GR1 + 0x000, (1u << 16) | (0xfu << 12) | (3u << 8) | 1u); /* CBAR0: S1, WB, NSH, VMID 1 */
+	wr(smmu, SMMU_GR1 + 0x800, 1u);                                         /* CBA2R0: VA64 */
+	wr(smmu, SMMU_CB0 + 0x010, (7u << 15) | (1u << 4) | 1u);                /* TCR2: SEP, AS, PASIZE 36 */
+	wr64(smmu, SMMU_CB0 + 0x020, pt_pa(0));                                 /* TTBR0, ASID 0 */
+	wr64(smmu, SMMU_CB0 + 0x028, 0);                                        /* TTBR1 */
+	wr(smmu, SMMU_CB0 + 0x030, 32u | (2u << 12) | (1u << 23));              /* TCR: T0SZ 32, NC walks, OS, 4K, EPD1 */
+	wr(smmu, SMMU_CB0 + 0x034, 0);                                          /* CONTEXTIDR */
+	wr(smmu, SMMU_CB0 + 0x038, 0xf404ff44u);                                /* MAIR0: NC, WB, DEV, INC_OCACHE */
+	wr(smmu, SMMU_CB0 + 0x03c, 0);
+	wr(smmu, SMMU_CB0 + 0x058, rd(smmu, SMMU_CB0 + 0x058));                 /* clear FSR */
+	/* TLB: invalidate CB0, sync. */
+	wr(smmu, SMMU_CB0 + 0x618, 0);
+	wr(smmu, SMMU_CB0 + 0x7f0, 0);
+	bool sync = wait_bits(smmu, SMMU_CB0 + 0x7f4, 1u, false, 1000);
+	/* Streams: S2CR first (translate via CB0), then the exact SMR. */
+	for (unsigned i = 0; i < 4; ++i) {
+		wr(smmu, 0xc00 + 4 * i, 0u);
+		wr(smmu, 0x800 + 4 * i, (1u << 31) | gmu_sids[i]);
+	}
+	/* Enable translation: M, TRE, AFE, CFRE, CFIE, ASIDPNE. */
+	wr(smmu, SMMU_CB0 + 0x000, 0x1067u);
+	printf("SWEET GPU: smmu CB0 TLB sync %s; CBAR0 %#x CBA2R0 %#x\n", sync ? "ok" : "TIMEOUT",
+	    rd(smmu, SMMU_GR1 + 0x000), rd(smmu, SMMU_GR1 + 0x800));
+	printf("SWEET GPU: smmu CB0 SCTLR %#x TCR %#x TCR2 %#x TTBR0 %#llx MAIR0 %#x FSR %#x\n",
+	    rd(smmu, SMMU_CB0 + 0x000), rd(smmu, SMMU_CB0 + 0x030), rd(smmu, SMMU_CB0 + 0x010),
+	    (unsigned long long)rd64(smmu, SMMU_CB0 + 0x020), rd(smmu, SMMU_CB0 + 0x038), rd(smmu, SMMU_CB0 + 0x058));
+	bool stuck = true;
+	for (unsigned i = 0; i < 4; ++i) {
+		uint32_t smr = rd(smmu, 0x800 + 4 * i), s2cr = rd(smmu, 0xc00 + 4 * i);
+		bool ok = smr == ((1u << 31) | gmu_sids[i]);
+		stuck &= ok;
+		printf("SWEET GPU: smmu SMR%u %#010x S2CR%u %#010x %s\n", i, smr, i, s2cr,
+		    ok ? "" : "(did not stick)");
+	}
+	printf("SWEET GPU: smmu sGFSR %#x after setup\n", rd(smmu, 0x48));
+	return sync && stuck;
+}
+
+static bool
+gpu_stage3(void)
+{
+	printf("SWEET GPU: stage 3: GMU memory + SMMU context (GMU stays in reset)\n");
+	if (!gpu_gmem_setup()) {
+		return false;
+	}
+	bool fw = gpu_fw_blocks(true);
+	gpu_checkpoint("about to program the GPU SMMU (CB0 + SMRs)");
+	bool ctx = gpu_smmu_gmu_context();
+	printf("SWEET GPU: stage 3 done: firmware %s, SMMU context %s\n",
+	    fw ? "placed" : "MISSING/BAD", ctx ? "ok" : "FAILED");
+	return fw && ctx;
+}
+
+/*
+ * ===== Stage 4: cold-boot the GMU firmware =====
+ *
+ * Sequence and constants follow Linux v6.6 a6xx_gmu.c for the a640 family
+ * (a6xx_hfi_init, a6xx_gmu_rpmh_init with pdc_address_offset 0x30090 and
+ * TCS3 CMD1 data 3, a6xx_gmu_fw_start/_fw_load/_power_config/_start with
+ * idle level ACTIVE); register numbers from a6xx_gmu.xml.h / a6xx.xml.h
+ * (GMU: n*4 from 0x2c6a000, RSCC: GMU + 0x23000 + n*4, PDC cfg/seq:
+ * 0xb290000/0xb490000 + n*4). Success is FW_INIT_RESULT & 0x1ff == 0x100
+ * (0xbabeface for firmware versions <= 0x20010004, DTCM word 0xff8).
+ * The GMU is left running, idle; no HFI messages yet (stage 5).
+ */
+#define GMU_R(n)          ((uint32_t)(n) * 4u)
+#define RSCC_R(n)         (0x23000u + (uint32_t)(n) * 4u)
+#define PDC_CFG_PA        0x0b290000u
+#define PDC_SEQ_PA        0x0b490000u
+#define A640_CHIPID       0x06040001u     /* live DT qcom,chipid */
+
+static void
+gpu_hfi_table_init(void)
+{
+	uint32_t *t = (uint32_t *)(gmem + GMEM_HFI);
+	bzero(t, 0x4000u);
+	/* table header: version, size (bytes as Linux writes it), qhdr0 offset
+	 * and qhdr size in dwords, 2 queues, 2 active */
+	t[0] = 0;
+	t[1] = 24u + 2u * 48u;
+	t[2] = 24u >> 2;
+	t[3] = 48u >> 2;
+	t[4] = 2;
+	t[5] = 2;
+	for (unsigned q = 0; q < 2; ++q) {
+		uint32_t *h = t + 6u + q * 12u;
+		h[0] = 1;                                  /* status */
+		h[1] = GVA_HFI + 0x1000u * (q + 1u);       /* iova */
+		h[2] = (10u << 8) | (q == 0 ? 0u : 1u);    /* type: cmd 0, gmu response 1 */
+		h[3] = 0x1000u >> 2;                       /* size (dwords) */
+		h[4] = 0;                                  /* msg_size */
+		h[5] = 0;                                  /* dropped */
+		h[6] = 1;                                  /* rx_watermark */
+		h[7] = 1;                                  /* tx_watermark */
+		h[8] = 1;                                  /* rx_request */
+		h[9] = 0;                                  /* tx_request */
+		h[10] = 0;                                 /* read_index */
+		h[11] = 0;                                 /* write_index */
+	}
+	flush_dcache64((addr64_t)(gmem + GMEM_HFI), 0x4000u, FALSE);
+}
+
+static bool
+gpu_rpmh_init(vm_offset_t gmu)
+{
+	vm_offset_t pdc = ml_io_map(PDC_CFG_PA, 0x10000);
+	vm_offset_t seq = ml_io_map(PDC_SEQ_PA, 0x10000);
+	if (!pdc || !seq) {
+		printf("SWEET GPU: PDC map failed\n");
+		return false;
+	}
+	wr(gmu, RSCC_R(0x004), 1u << 24);                 /* RSC_STATUS0_DRV0: no SDE clock gating */
+	wr(gmu, RSCC_R(0x00b), 1);                        /* PDC_SLAVE_ID_DRV0 */
+	wr(gmu, RSCC_R(0x00e), 0);                        /* HIDDEN_TCS_CMD0_DATA */
+	wr(gmu, RSCC_R(0x00d), 0);                        /* HIDDEN_TCS_CMD0_ADDR */
+	wr(gmu, RSCC_R(0x00e + 2), 0);
+	wr(gmu, RSCC_R(0x00d + 2), 0);
+	wr(gmu, RSCC_R(0x00e + 4), 0x80000000u);
+	wr(gmu, RSCC_R(0x00d + 4), 0);
+	wr(gmu, RSCC_R(0x100), 0);                        /* OVERRIDE_START_ADDR */
+	wr(gmu, RSCC_R(0x008), 0x4520);                   /* PDC_SEQ_START_ADDR */
+	wr(gmu, RSCC_R(0x009), 0x4510);                   /* PDC_MATCH_VALUE_LO */
+	wr(gmu, RSCC_R(0x00a), 0x4514);                   /* PDC_MATCH_VALUE_HI */
+	static const uint32_t rsc_seq[5] = {0xa7a506a0, 0xa1e6a6e7, 0xa2e081e1, 0xe9a982e2, 0x0020e8a8};
+	for (unsigned i = 0; i < 5; ++i) {
+		wr(gmu, RSCC_R(0x180 + i), rsc_seq[i]);       /* SEQ_MEM_0_DRV0 */
+	}
+	static const uint32_t pdc_seq[5] = {0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc};
+	for (unsigned i = 0; i < 5; ++i) {
+		wr(seq, i * 4u, pdc_seq[i]);                  /* PDC_GPU_SEQ_MEM_0 */
+	}
+	/* TCS1 (power down) and TCS3 (power up): cx/mx/gfx ARC levels */
+	const uint32_t tcs[2] = {0x1572, 0x15d6};         /* TCSn_CONTROL; +1 ENABLE, +2 WAIT, +3.. CMD */
+	const uint32_t data[2][3] = {{1, 0, 0}, {2, 3, 3}};
+	const uint32_t addr[3] = {0x30010, 0x30000, 0x30090};
+	for (unsigned t = 0; t < 2; ++t) {
+		wr(pdc, (tcs[t] + 1) * 4u, 7);                /* CMD_ENABLE_BANK */
+		wr(pdc, (tcs[t] + 2) * 4u, 0);                /* CMD_WAIT_FOR_CMPL_BANK */
+		wr(pdc, (tcs[t] + 0) * 4u, 0);                /* CONTROL */
+		for (unsigned c = 0; c < 3; ++c) {
+			wr(pdc, (tcs[t] + 3 + 4 * c) * 4u, 0x10108);   /* CMDc_MSGID */
+			wr(pdc, (tcs[t] + 4 + 4 * c) * 4u, addr[c]);   /* CMDc_ADDR */
+			wr(pdc, (tcs[t] + 5 + 4 * c) * 4u, data[t][c]);/* CMDc_DATA */
+		}
+	}
+	wr(pdc, 0x1148 * 4u, 0);                          /* PDC_GPU_SEQ_START_ADDR */
+	wr(pdc, 0x1140 * 4u, 0x80000001u);                /* PDC_GPU_ENABLE_PDC */
+	/* a6xx_rpmh_stop */
+	wr(gmu, GMU_R(0x9307), 1);                        /* RSCC_CONTROL_REQ */
+	bool off = wait_bits(gmu, RSCC_R(0x004), 1u << 16, true, 10000);
+	wr(gmu, GMU_R(0x9307), 0);
+	printf("SWEET GPU: RSC/PDC microcode loaded, RSC %s (status0 %#x)\n",
+	    off ? "parked" : "PARK TIMEOUT", rd(gmu, RSCC_R(0x004)));
+	return off;
+}
+
+static bool
+gpu_rpmh_start(vm_offset_t gmu)
+{
+	wr(gmu, GMU_R(0x9307), 1u << 1);                  /* RSCC_CONTROL_REQ: power on */
+	bool ack = wait_bits(gmu, GMU_R(0x9308), 1u << 1, true, 10000);
+	bool idle = ack && wait_bits(gmu, RSCC_R(0x101), 0xffffffffu, false, 10000); /* SEQ_BUSY_DRV0 */
+	wr(gmu, GMU_R(0x9307), 0);
+	printf("SWEET GPU: RSC power-on ack %s, sequencer %s (busy %#x)\n", ack ? "ok" : "TIMEOUT",
+	    idle ? "idle" : "STUCK", rd(gmu, RSCC_R(0x101)));
+	return ack && idle;
+}
+
+static void
+gpu_fw_tcm_load(vm_offset_t gmu)
+{
+	for (unsigned o = 0; o + 16u <= gmu_fw_size; ) {
+		const uint32_t *b = (const uint32_t *)((uintptr_t)gmu_fw + o);
+		uint32_t a = b[0], len = b[1], base = 0;
+		bool tcm = true;
+		if (a < 0x4000u) {
+			base = GMU_R(0x0c00) + a;                 /* CM3_ITCM_START */
+		} else if (a >= 0x40000u && a < 0x44000u) {
+			base = GMU_R(0x1c00) + (a - 0x40000u);    /* CM3_DTCM_START */
+		} else {
+			tcm = false;
+		}
+		if (tcm) {
+			for (uint32_t i = 0; i < len / 4u; ++i) {
+				wr(gmu, base + 4u * i, b[4 + i]);
+			}
+		}
+		o += 16u + len;
+	}
+}
+
+static void
+gpu_gmu_report(vm_offset_t gmu, const char *when)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	printf("SWEET GPU: [%s] FW_INIT_RESULT %#x SYSRESET %#x GMU2HOST %#x AO_HOST %#x\n", when,
+	    rd(gmu, GMU_FW_INIT), rd(gmu, GMU_SYSRESET), rd(gmu, GMU_R(0x5192)), rd(gmu, GMU_R(0x9305)));
+	if (smmu) {
+		uint32_t fsr = rd(smmu, SMMU_CB0 + 0x058);
+		printf("SWEET GPU: [%s] smmu CB0 FSR %#x FSYNR0 %#x FAR %#llx sGFSR %#x\n", when, fsr,
+		    rd(smmu, SMMU_CB0 + 0x068), (unsigned long long)rd64(smmu, SMMU_CB0 + 0x060), rd(smmu, 0x48));
+	}
+	flush_dcache64((addr64_t)(gmem + GMEM_HFI), 0x4000u, FALSE);
+	const uint32_t *h = (const uint32_t *)(gmem + GMEM_HFI);
+	printf("SWEET GPU: [%s] hfi q0 status %u r/w %u/%u, q1 status %u r/w %u/%u\n", when,
+	    h[6], h[16], h[17], h[18], h[28], h[29]);
+}
+
+static bool
+gpu_stage4(void)
+{
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	if (!gmu || !gmu_fw) {
+		printf("SWEET GPU: stage 4 needs the GMU map and the firmware\n");
+		return false;
+	}
+	printf("SWEET GPU: stage 4: GMU cold boot\n");
+	gpu_hfi_table_init();
+	if (!gpu_rpmh_init(gmu)) {
+		return false;
+	}
+	wr(gmu, GMU_R(0x51cc), 1);                        /* GENERAL_7: register retention */
+	if (!gpu_rpmh_start(gmu)) {
+		return false;
+	}
+	gpu_fw_tcm_load(gmu);
+	uint32_t ver = rd(gmu, GMU_R(0x1c00 + 0xff8));
+	bool legacy = ver <= 0x20010004u;
+	printf("SWEET GPU: TCM blocks written; fw version word %#x -> expect %s\n", ver,
+	    legacy ? "0xbabeface" : "init & 0x1ff == 0x100");
+	wr(gmu, GMU_FW_INIT, 0);
+	wr(gmu, GMU_R(0x5001), 0x02);                     /* CM3_BOOT_CONFIG */
+	wr(gmu, GMU_R(0x5185), GVA_HFI);                  /* HFI_QTBL_ADDR */
+	wr(gmu, GMU_R(0x5184), 1);                        /* HFI_QTBL_INFO */
+	wr(gmu, GMU_R(0x9311), (1u << 31) | (0xau << 18) | 0xa0u); /* AHB_FENCE_RANGE_0 */
+	wr(gmu, GMU_R(0x502d), 0x4052);                   /* CM3_CFG */
+	uint32_t chipid = (A640_CHIPID & 0xffff0000u) | ((A640_CHIPID << 4) & 0xf000u) |
+	    ((A640_CHIPID << 8) & 0x0f00u);
+	wr(gmu, GMU_R(0x5182), chipid);                   /* HFI_SFR_ADDR: chip id */
+	wr(gmu, GMU_R(0x5100), GVA_LOG | (0x4000u / 0x1000u - 1u)); /* PWR_COL_CP_MSG: log */
+	/* a6xx_gmu_power_config, idle level ACTIVE */
+	wr(gmu, GMU_R(0x4c0f), 1);                        /* SYS_BUS_CONFIG */
+	wr(gmu, GMU_R(0x4c00), 1);                        /* ICACHE_CONFIG */
+	wr(gmu, GMU_R(0x4c01), 1);                        /* DCACHE_CONFIG */
+	wr(gmu, GMU_R(0x50c0), 0x9c40400);                /* PWR_COL_INTER_FRAME_CTRL */
+	wr(gmu, GMU_R(0x50e8), rd(gmu, GMU_R(0x50e8)) | 0xf11u); /* RPMH_CTRL: interface + votes */
+	gpu_gmu_report(gmu, "before release");
+	gpu_checkpoint("about to release the GMU from reset");
+	/* a6xx_gmu_start */
+	wr(gmu, GMU_SYSRESET, 1);
+	wr(gmu, GMU_R(0x5101), 0);                        /* PWR_COL_CP_RESP: log wptr */
+	wr(gmu, GMU_SYSRESET, 0);
+	uint32_t want = legacy ? 0xbabefaceu : 0x100u, mask = legacy ? 0xffffffffu : 0x1ffu, v = 0;
+	unsigned us = 0;
+	for (; us < 200000u; us += 10u) {
+		v = rd(gmu, GMU_FW_INIT);
+		if ((v & mask) == want) {
+			break;
+		}
+		delay(10);
+	}
+	printf("SWEET GPU: GMU firmware init %s after %u us: FW_INIT_RESULT %#x\n",
+	    (v & mask) == want ? "OK" : "TIMEOUT", us, v);
+	gpu_gmu_report(gmu, "after release");
+	gpu_wait_ms(1000);
+	gpu_gmu_report(gmu, "+1 s");
+	printf("SWEET GPU: stage 4 done (GMU left running, idle)\n");
+	return (v & mask) == want;
+}
+
+/*
+ * ===== Stage 5: HFI v2 handshake =====
+ *
+ * Linux v6.6 a6xx_hfi_start() for non-legacy GMUs (everything but the a630
+ * family): PERF_TABLE (4), BW_TABLE (3), CORE_FW_START (14), START (10).
+ * Header: seqnum << 20 | type(cmd 0) << 16 | dwords << 8 | id; writes pad
+ * to 4 dwords with 0xfafafafa; HOST2GMU_INTR_SET bit 0 rings; responses
+ * come on queue 1, GMU2HOST_INTR_INFO bit 0 (MSGQ), read index realigned
+ * to 4. Perf votes: a6xx_gmu_rpmh_arc_votes_init() over the cmd-db ARC
+ * tables ("gfx.lvl"/"cx.lvl" primary, "mx.lvl" secondary) with the
+ * mainline sm8150 OPP levels (speed bin 0: 257/345/427/499.2/585 MHz at
+ * LOW_SVS/SVS/SVS_L1/SVS_L2/NOM; GMU 200 MHz at MIN_SVS). BW table:
+ * a640_build_bw_table() (one "off" level). The HFI memory is cacheable:
+ * the CPU invalidates before reading and cleans after writing, and only
+ * talks while the GMU has nothing outstanding.
+ */
+#define HFI_Q0            (GMEM_HFI + 0x1000u)
+#define HFI_Q1            (GMEM_HFI + 0x2000u)
+#define HFI_QSIZE         (0x1000u / 4u)
+
+static unsigned hfi_seq;
+
+static void
+hfi_sync(void)
+{
+	flush_dcache64((addr64_t)(gmem + GMEM_HFI), 0x4000u, FALSE);
+}
+
+static int
+hfi_send(vm_offset_t gmu, unsigned id, uint32_t *msg, unsigned dwords, uint32_t *payload)
+{
+	uint32_t *t = (uint32_t *)(gmem + GMEM_HFI);
+	uint32_t *q0h = t + 6, *q1h = t + 18;
+	uint32_t *q0 = (uint32_t *)(gmem + HFI_Q0), *q1 = (uint32_t *)(gmem + HFI_Q1);
+	unsigned seq = (++hfi_seq) % 0xfffu;
+	msg[0] = (seq << 20) | (0u << 16) | (dwords << 8) | id;
+	hfi_sync();
+	uint32_t w = q0h[11], r = q0h[10];
+	unsigned space = (r - w - 1u) & (HFI_QSIZE - 1u);
+	if (space < dwords + 4u) {
+		printf("SWEET GPU: hfi id %u: no queue space (r %u w %u)\n", id, r, w);
+		return ENOSPC;
+	}
+	for (unsigned i = 0; i < dwords; ++i) {
+		q0[w] = msg[i];
+		w = (w + 1u) % HFI_QSIZE;
+	}
+	for (; w % 4u; w = (w + 1u) % HFI_QSIZE) {
+		q0[w] = 0xfafafafau;
+	}
+	q0h[11] = w;
+	hfi_sync();
+	wr(gmu, GMU_R(0x5194), 1);                        /* HOST2GMU_INTR_SET */
+	bool got = wait_bits(gmu, GMU_R(0x5192), 1u, true, 100000);  /* GMU2HOST_INTR_INFO.MSGQ */
+	if (!got) {
+		hfi_sync();
+		printf("SWEET GPU: hfi id %u seq %u: no response (q0 r/w %u/%u, q1 r/w %u/%u, info %#x)\n",
+		    id, seq, q0h[10], q0h[11], q1h[10], q1h[11], rd(gmu, GMU_R(0x5192)));
+		return ETIMEDOUT;
+	}
+	wr(gmu, GMU_R(0x5191), 1);                        /* GMU2HOST_INTR_CLR */
+	for (unsigned tries = 0; tries < 8; ++tries) {
+		hfi_sync();
+		uint32_t rr = q1h[10], ww = q1h[11];
+		if (rr == ww) {
+			printf("SWEET GPU: hfi id %u seq %u: response queue empty\n", id, seq);
+			return ENOENT;
+		}
+		uint32_t resp[24] = {0};
+		uint32_t hdr = q1[rr], n = (hdr >> 8) & 0xffu;
+		for (unsigned i = 0; i < n && i < 24u; ++i) {
+			resp[i] = q1[rr];
+			rr = (rr + 1u) % HFI_QSIZE;
+		}
+		rr = ((rr + 3u) & ~3u) % HFI_QSIZE;
+		q1h[10] = rr;
+		hfi_sync();
+		if ((hdr & 0xffu) == 100u) {                  /* HFI_F2H_MSG_ERROR */
+			printf("SWEET GPU: hfi GMU error code %u (%#x %#x)\n", resp[1], resp[2], resp[3]);
+			continue;
+		}
+		if (((resp[1] >> 20) & 0xfffu) != seq) {
+			printf("SWEET GPU: hfi unexpected response hdr %#x ret %#x\n", hdr, resp[1]);
+			continue;
+		}
+		printf("SWEET GPU: hfi id %u seq %u -> ack hdr %#x error %u payload %#x\n",
+		    id, seq, hdr, resp[2], resp[3]);
+		if (payload) {
+			*payload = resp[3];
+		}
+		return resp[2] ? EIO : 0;
+	}
+	return EIO;
+}
+
+static uint32_t
+arc_vote(const uint16_t *pri, unsigned np, const uint16_t *sec, unsigned ns, unsigned level)
+{
+	unsigned pi = 0, si = 0, j;
+	for (j = 0; j < np; ++j) {
+		if (pri[j] >= level) {
+			pi = j;
+			break;
+		}
+	}
+	if (j == np) {
+		return 0xffffffffu;
+	}
+	for (j = 0; j < ns; ++j) {
+		if (sec[j] >= level) {
+			si = j;
+			break;
+		} else if (sec[j]) {
+			si = j;
+		}
+	}
+	return ((uint32_t)pri[pi] << 16) | (si << 8) | pi;
+}
+
+static bool
+gpu_stage5(void)
+{
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	if (!gmu) {
+		return false;
+	}
+	printf("SWEET GPU: stage 5: HFI v2 handshake\n");
+	uint16_t gfx[16], cx[16], mx[16];
+	unsigned ng = 0, nc = 0, nm = 0;
+	int e1 = sweet_cmd_db_aux("gfx.lvl", gfx, 16, &ng);
+	int e2 = sweet_cmd_db_aux("cx.lvl", cx, 16, &nc);
+	int e3 = sweet_cmd_db_aux("mx.lvl", mx, 16, &nm);
+	printf("SWEET GPU: cmd-db gfx.lvl %d/%u cx.lvl %d/%u mx.lvl %d/%u\n", e1, ng, e2, nc, e3, nm);
+	if (e1 || e2 || e3 || !ng || !nc || !nm) {
+		return false;
+	}
+	for (unsigned k = 0; k < ng; k += 8) {
+		printf("SWEET GPU: gfx.lvl[%u..] %u %u %u %u %u %u %u %u\n", k, gfx[k], gfx[k + 1],
+		    gfx[k + 2], gfx[k + 3], gfx[k + 4], gfx[k + 5], gfx[k + 6], gfx[k + 7]);
+	}
+	static const uint32_t gpu_khz[6] = {0, 257000, 345000, 427000, 499200, 585000};
+	static const unsigned gpu_lvl[6] = {0, 64, 128, 192, 224, 256};
+	static const uint32_t gmu_khz[2] = {0, 200000};
+	static const unsigned gmu_lvl[2] = {0, 48};
+
+	uint32_t perf[3 + 16 * 3 + 4 * 2];
+	bzero(perf, sizeof(perf));
+	perf[1] = 6;
+	perf[2] = 2;
+	for (unsigned i = 0; i < 6; ++i) {
+		uint32_t v = arc_vote(gfx, ng, mx, nm, gpu_lvl[i]);
+		if (v == 0xffffffffu) {
+			printf("SWEET GPU: gfx level %u not in cmd-db\n", gpu_lvl[i]);
+			return false;
+		}
+		perf[3 + 3 * i] = v;
+		perf[3 + 3 * i + 1] = 0xffffffffu;            /* acd: none */
+		perf[3 + 3 * i + 2] = gpu_khz[i];
+		printf("SWEET GPU: gx level %u: %u kHz vote %#x\n", i, gpu_khz[i], v);
+	}
+	for (unsigned i = 0; i < 2; ++i) {
+		uint32_t v = arc_vote(cx, nc, mx, nm, gmu_lvl[i]);
+		if (v == 0xffffffffu) {
+			printf("SWEET GPU: cx level %u not in cmd-db\n", gmu_lvl[i]);
+			return false;
+		}
+		perf[3 + 48 + 2 * i] = v;
+		perf[3 + 48 + 2 * i + 1] = gmu_khz[i];
+		printf("SWEET GPU: cx level %u: %u kHz vote %#x\n", i, gmu_khz[i], v);
+	}
+
+	uint32_t bw[1 + 5 + 6 + 12 + 8 + 128];
+	bzero(bw, sizeof(bw));
+	uint32_t *b = bw + 1;
+	b[0] = 1;                                         /* bw_level_num */
+	b[1] = 3;                                         /* cnoc_cmds_num */
+	b[2] = 3;                                         /* ddr_cmds_num */
+	b[3] = 1;                                         /* cnoc_wait_bitmask */
+	b[4] = 1;                                         /* ddr_wait_bitmask */
+	uint32_t *cnoc_addr = b + 5, *cnoc_data = b + 11, *ddr_addr = b + 23, *ddr_data = b + 31;
+	cnoc_addr[0] = 0x50034;
+	cnoc_addr[1] = 0x5007c;
+	cnoc_addr[2] = 0x5004c;
+	cnoc_data[0] = 0x40000000;
+	cnoc_data[1] = 0x00000000;
+	cnoc_data[2] = 0x40000000;
+	cnoc_data[6 + 0] = 0x60000001;
+	cnoc_data[6 + 1] = 0x20000001;
+	cnoc_data[6 + 2] = 0x60000001;
+	ddr_addr[0] = 0x50000;
+	ddr_addr[1] = 0x5003c;
+	ddr_addr[2] = 0x5000c;
+	ddr_data[0] = 0x40000000;
+	ddr_data[1] = 0x40000000;
+	ddr_data[2] = 0x40000000;
+
+	uint32_t core[2] = {0, 0}, start[1] = {0};
+	wr(gmu, GMU_R(0x5191), 0xffffffffu);              /* GMU2HOST_INTR_CLR: stale bits */
+	if (hfi_send(gmu, 4, perf, sizeof(perf) / 4u, NULL) ||
+	    hfi_send(gmu, 3, bw, sizeof(bw) / 4u, NULL) ||
+	    hfi_send(gmu, 14, core, 2, NULL) ||
+	    hfi_send(gmu, 10, start, 1, NULL)) {
+		gpu_gmu_report(gmu, "hfi failed");
+		return false;
+	}
+	gpu_gmu_report(gmu, "hfi started");
+	printf("SWEET GPU: stage 5 done: GMU accepted the perf/bw tables and START\n");
+	return true;
+}
+
+/*
+ * ===== Stage 6: GX power through the GMU, first GPU register reads =====
+ *
+ * Linux v6.6, non-legacy GMU: a6xx_hfi_set_freq() (GX_BW_PERF_VOTE 30,
+ * blocking ack, perf index, bw 0), then a6xx_gmu_set_oob(GPU_SET):
+ * HOST2GMU_INTR_SET bit 30, ack GMU2HOST_INTR_INFO bit 31, cleared via
+ * GMU2HOST_INTR_CLR. The GMU then powers the GX domain and rail itself.
+ * The AHB fence (AO_AHB_FENCE_CTRL) is put in allow mode (0) first, as
+ * Linux leaves it. GPU registers: Linux a6xx.xml.h, n*4 from 0x2c00000.
+ * The OOB is left set (GX stays on); no GPU register is written.
+ */
+#define GPU_PA            0x02c00000u
+#define GPU_SIZE          0x00040000u
+
+static bool
+gpu_stage6(void)
+{
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	vm_offset_t gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (!gmu || !gpucc) {
+		return false;
+	}
+	printf("SWEET GPU: stage 6: GX power via GMU OOB\n");
+	printf("SWEET GPU: before: GX GDSC %#010x RPMH_POWER_STATE %#x SPTPRAC %#x AHB_FENCE %#x\n",
+	    rd(gpucc, 0x100c), rd(gmu, GMU_R(0x50ec)), rd(gmu, GMU_R(0x50d0)), rd(gmu, GMU_R(0x9310)));
+	wr(gmu, GMU_R(0x9310), 0);                        /* AO_AHB_FENCE_CTRL: allow */
+	uint32_t vote[4] = {0, 1, 1, 0};                  /* hdr, ack_type blocking, perf index 1 (257 MHz), bw 0 */
+	if (hfi_send(gmu, 30, vote, 4, NULL)) {
+		printf("SWEET GPU: GX_BW_PERF_VOTE failed\n");
+		return false;
+	}
+	gpu_checkpoint("about to ask the GMU for GX (OOB GPU_SET)");
+	wr(gmu, GMU_R(0x5194), 1u << 30);                 /* HOST2GMU_INTR_SET: OOB GPU_SET */
+	bool ack = wait_bits(gmu, GMU_R(0x5192), 1u << 31, true, 100000);
+	uint32_t info = rd(gmu, GMU_R(0x5192));
+	wr(gmu, GMU_R(0x5191), 1u << 31);                 /* GMU2HOST_INTR_CLR */
+	uint32_t gx = rd(gpucc, 0x100c);
+	printf("SWEET GPU: OOB GPU_SET %s (info %#x); GX GDSC %#010x (%s) RPMH_POWER_STATE %#x SPTPRAC %#x\n",
+	    ack ? "acked" : "TIMEOUT", info, gx, (gx & GDSC_PWR_ON) ? "on" : "off",
+	    rd(gmu, GMU_R(0x50ec)), rd(gmu, GMU_R(0x50d0)));
+	gpu_gmu_report(gmu, "oob");
+	if (!ack || !(gx & GDSC_PWR_ON)) {
+		printf("SWEET GPU: GX not powered: GPU registers not read\n");
+		return false;
+	}
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	gpu_checkpoint("GX on; about to read RBBM_STATUS");
+	printf("SWEET GPU: RBBM_STATUS %#x STATUS1 %#x INT_0_STATUS %#x\n",
+	    rd(gpu, 0x210 * 4u), rd(gpu, 0x211 * 4u), rd(gpu, 0x201 * 4u));
+	printf("SWEET GPU: CP_SQE_CNTL %#x CP_HW_FAULT %#x CP_STATUS_1 %#x CP_PROTECT_CNTL %#x GBIF_HALT %#x\n",
+	    rd(gpu, 0x808 * 4u), rd(gpu, 0x821 * 4u), rd(gpu, 0x825 * 4u), rd(gpu, 0x84f * 4u),
+	    rd(gpu, 0x3c45 * 4u));
+	printf("SWEET GPU: stage 6 done: GX powered by the GMU, GPU registers readable (OOB left set)\n");
+	return true;
+}
+
+/*
+ * ===== Stage 7: GPU-side SMMU context, GPU memory, register init (no CP start) =====
+ *
+ * Linux v6.6 a6xx_gpu.c hw_init() for the a640, up to but NOT including
+ * "gpu_write(CP_SQE_CNTL, 1)": GBIF unhalt, secure TSB off, 64-bit address
+ * mode, HWCG (a640_hwcg[], SP clock gated around it, RBBM_CLOCK_CNTL
+ * 0x8aa8aa82), GBIF QoS, UCHE ranges (GMEM 1 MiB at 0x100000), ROQ/mem
+ * pool, PC_DBG_ECO 0x00200200, UBWC (amsbc 1, hbb_lo 2), hang detection,
+ * CP protect (a6xx_protect[], 32 slots), SQE image (first dword skipped,
+ * adreno_fw_create_bo) at CP_SQE_INSTR_BASE, a 32 KiB ring at CP_RB_BASE
+ * with RB_CNTL BUFSZ 12 BLKSZ 2 NO_UPDATE (no hw APRIV on a640) and the
+ * RPTR shadow. Register numbers: a6xx.xml.h. mxtpasontop's A618 notes:
+ * an early SQE_CNTL write was not harmless; this stage never writes it.
+ * GPU traffic (DT gfx3d_user: SID 0 mask 0x401) -> exact SMRs 0x000/0x400
+ * -> CB1 (the GMU keeps CB0 for now); its tables map the buffers at GPU VA
+ * 0x01000000 (ring/SQE read-only, shadow privileged, as Linux maps them).
