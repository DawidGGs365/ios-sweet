diff --git a/bsd/dev/sweet_mailbox.c b/bsd/dev/sweet_mailbox.c
new file mode 100644
index 0000000..86832fb
--- /dev/null
+++ b/bsd/dev/sweet_mailbox.c
@@ -0,0 +1,299 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEETBOX: kernel-side extractor for files deployed via the logdump partition.
+ *
+ * tools/sweet-mailbox.py packs files into a raw image:
+ *   [SWEETBOX magic 8 B][file count 4 B][name_len 2 B][name][data_len 4 B][data]...
+ * sweet_mailbox_probe() (boot-arg sweetmailbox=1) reads that image from
+ * "logdump" via sweet_ufs_read_partition(), extracts each file to
+ * /private/var/tmp/<name> on the iOS root (flat: "/" in names becomes "_";
+ * the kernel has no mkdir KPI), then stamps the partition with
+ * SWEETDNE so the kernel skips it on the next boot.
+ *
+ * Entries named ROOT/<path> are not extracted there. With boot-arg
+ * sweetboxroot=1, sweet_mailbox_root_install() writes them to /<path> on
+ * the root right after it mounts (bsd_init, before launchd), so a
+ * launchd.plist from the box is used by this very boot, and a broken one
+ * can be replaced the same way. The parent directory must exist.
+ *
+ * After each extraction the thread writes BOX_DONE_FILE (its text: how many
+ * files). /usr/libexec/sweet-autorun waits for it before it runs
+ * /private/var/tmp/autorun.sh, so every file from the box is in place.
+ * Before launchd the root pass empties it: there is no RTC, the clock starts
+ * at 0 on every boot, so the last boot's file looked newer than this boot
+ * (0116 on the phone: autorun found it before the box was extracted).
+ * sweet-autorun waits for it to be non-empty.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/uio.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_ufs_read_partition(const char *part, uint64_t offset,
+    uint32_t size, void **buf_out);
+extern int sweet_ufs_stamp_partition(const char *part, const uint8_t sector[512]);
+
+#define BOX_MAGIC      "SWEETBOX"
+#define BOX_MAGIC_DONE "SWEETDNE"
+#define BOX_MAGIC_LEN  8
+#define BOX_MAX_SIZE   (64u * 1024u * 1024u)
+#define BOX_BASE_DIR   "/private/var/tmp"
+#define BOX_DONE_FILE  BOX_BASE_DIR "/SWEETBOX.done"
+#define BOX_ROOT       "ROOT/"
+#define BOX_ROOT_LEN   5
+
+/* ROOT/ entries the root pass wrote this boot (for the SWEETDNE stamp). */
+static unsigned box_root_installed;
+
+static void
+box_wait_ms(unsigned ms)
+{
+	uint64_t d;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &d);
+	assert_wait_deadline((event_t)&box_wait_ms, THREAD_UNINT, d);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+box_write_file(const char *path, const uint8_t *data, uint32_t size, vfs_context_t ctx)
+{
+	struct vnode *vp = NULLVP;
+	/* vnode_open takes kernel F-flags (FWRITE), not O_WRONLY. */
+	int err = vnode_open(path, FWRITE | O_CREAT, 0755, 0, &vp, ctx);
+	if (err || vp == NULLVP) {
+		printf("SWEET BOX: open %s: %d\n", path, err);
+		return err ? err : ENOENT;
+	}
+	/*
+	 * vnode_open() ignores O_TRUNC (vn_open_auth leaves it to the open
+	 * syscall), so a shorter file kept the old one's tail and 0118 did not
+	 * empty SWEETBOX.done. Truncate like kern_core.c does.
+	 */
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_data_size, 0);
+	err = vnode_setattr(vp, &va, ctx);
+	if (err) {
+		printf("SWEET BOX: truncate %s: %d\n", path, err);
+	}
+	if (!err && size) {
+		uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+		uio_addiov(uio, (user_addr_t)(uintptr_t)data, size);
+		err = VNOP_WRITE(vp, uio, 0, ctx);
+		uio_free(uio);
+	}
+	int cerr = vnode_close(vp, FWRITE, ctx);
+	return err ? err : cerr;
+}
+
+/* No empty, "." or ".." components: ROOT/ paths stay what they say. */
+static bool
+box_root_path_ok(const char *path)
+{
+	const char *c = path;
+	for (;;) {
+		const char *e = strchr(c, '/');
+		size_t n = e ? (size_t)(e - c) : strlen(c);
+		if (n == 0 || (n == 1 && c[0] == '.') || (n == 2 && c[0] == '.' && c[1] == '.')) {
+			return false;
+		}
+		if (!e) {
+			return true;
+		}
+		c = e + 1;
+	}
+}
+
+/*
+ * Reads the box from the partition in boot-arg sweetboxpart (default
+ * logdump). Returns the buffer (BOX_MAX_SIZE, kmem_free it) when it holds an
+ * unextracted box, else NULL.
+ */
+static void *
+box_read(const char *part, uint32_t *nfiles_out)
+{
+	void *buf = NULL;
+	int err = sweet_ufs_read_partition(part, 0, BOX_MAX_SIZE, &buf);
+	if (err || !buf) {
+		printf("SWEET BOX: read %s: %d%s\n", part, err,
+		    err == ENOENT ? " (not on UFS LUN 0; pick one with sweetboxpart=)" : "");
+		return NULL;
+	}
+	printf("SWEET BOX: using partition %s\n", part);
+	const uint8_t *p = (const uint8_t *)buf;
+	uint32_t nfiles = 0;
+	if (memcmp(p, BOX_MAGIC_DONE, BOX_MAGIC_LEN) == 0) {
+		printf("SWEET BOX: SWEETDNE — already extracted, skipping\n");
+	} else if (memcmp(p, BOX_MAGIC, BOX_MAGIC_LEN) != 0) {
+		printf("SWEET BOX: no SWEETBOX magic, skipping\n");
+	} else {
+		memcpy(&nfiles, p + BOX_MAGIC_LEN, 4);
+		if (nfiles == 0 || nfiles > 512) {
+			printf("SWEET BOX: bad file count %u\n", nfiles);
+			nfiles = 0;
+		}
+	}
+	if (!nfiles) {
+		kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+		return NULL;
+	}
+	*nfiles_out = nfiles;
+	return buf;
+}
+
+/*
+ * One pass over the box. root_pass: write only the ROOT/ entries, to their
+ * path on the root. Otherwise extract the rest flat to BOX_BASE_DIR.
+ * Returns how many entries of that kind were written; *total gets how many
+ * there are.
+ */
+static unsigned
+box_walk(const uint8_t *p, uint32_t nfiles, bool root_pass, unsigned *total)
+{
+	const uint8_t *cur = p + BOX_MAGIC_LEN + 4;
+	const uint8_t *end = p + BOX_MAX_SIZE;
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned written = 0, mine = 0;
+
+	for (uint32_t i = 0; i < nfiles; i++) {
+		if (cur + 2 > end) { printf("SWEET BOX: truncated\n"); break; }
+		uint16_t namelen;
+		memcpy(&namelen, cur, 2); cur += 2;
+		if (!namelen || namelen > 255 || cur + namelen + 4 > end) {
+			printf("SWEET BOX: bad entry %u\n", i); break;
+		}
+		char name[256];
+		memcpy(name, cur, namelen); name[namelen] = '\0'; cur += namelen;
+		uint32_t size;
+		memcpy(&size, cur, 4); cur += 4;
+		if (cur + size > end) { printf("SWEET BOX: %s: overrun\n", name); break; }
+		const uint8_t *data = cur;
+		cur += size;
+
+		bool is_root = strncmp(name, BOX_ROOT, BOX_ROOT_LEN) == 0;
+		if (is_root != root_pass) {
+			continue;
+		}
+		mine++;
+		char dest[512];
+		if (is_root) {
+			if (!box_root_path_ok(name + BOX_ROOT_LEN)) {
+				printf("SWEET BOX: %s: bad root path, skipped\n", name);
+				continue;
+			}
+			snprintf(dest, sizeof(dest), "/%s", name + BOX_ROOT_LEN);
+		} else {
+			for (unsigned k = 0; name[k]; k++) {
+				if (name[k] == '/') {
+					name[k] = '_';         /* flat: no directories */
+				}
+			}
+			if (name[0] == '.') {
+				name[0] = '_';             /* no ".." or hidden names */
+			}
+			snprintf(dest, sizeof(dest), BOX_BASE_DIR "/%s", name);
+		}
+		if (box_write_file(dest, data, size, ctx) == 0) {
+			printf("SWEET BOX: %s %s (%u B)\n", is_root ? "installed" : "extracted", dest, size);
+			written++;
+		}
+	}
+	*total = mine;
+	return written;
+}
+
+static void
+box_part(char part[40])
+{
+	/* The UFS driver only talks to LUN 0 (where userdata is). 0113 asked
+	 * for logdump and got ENOENT: it lives on another LUN. The partition
+	 * is a boot-arg so no rebuild is needed to move it. */
+	strlcpy(part, "logdump", 40);
+	(void)PE_parse_boot_arg_str("sweetboxpart", part, 40);
+}
+
+static void
+box_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	box_wait_ms(30000);
+
+	char part[40];
+	box_part(part);
+	uint32_t nfiles = 0;
+	void *buf = box_read(part, &nfiles);
+	if (!buf) {
+		goto out;
+	}
+	printf("SWEET BOX: %u file(s) to extract\n", nfiles);
+	unsigned total = 0;
+	unsigned extracted = box_walk(buf, nfiles, false, &total);
+	unsigned root_total = nfiles - total;
+	printf("SWEET BOX: done, %u/%u files, %u/%u root files\n",
+	    extracted, total, box_root_installed, root_total);
+	char done[32];
+	int n = snprintf(done, sizeof(done), "%u/%u\n", extracted, total);
+	int derr = box_write_file(BOX_DONE_FILE, (const uint8_t *)done, (uint32_t)n, vfs_context_kernel());
+	printf("SWEET BOX: wrote " BOX_DONE_FILE ": %d\n", derr);
+	if (extracted == total && box_root_installed == root_total) {
+		uint8_t stamp[512];
+		bzero(stamp, sizeof(stamp));
+		memcpy(stamp, BOX_MAGIC_DONE, BOX_MAGIC_LEN);
+		int err = sweet_ufs_stamp_partition(part, stamp);
+		printf("SWEET BOX: stamped SWEETDNE: %d\n", err);
+	}
+	kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* bsd_init, right after the root is mounted and before launchd runs. */
+void
+sweet_mailbox_root_install(void)
+{
+	unsigned enabled = 0, root = 0;
+	(void)PE_parse_boot_argn("sweetmailbox", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetboxroot", &root, sizeof(root));
+	if (!enabled) {
+		return;
+	}
+	int err = box_write_file(BOX_DONE_FILE, NULL, 0, vfs_context_kernel());
+	printf("SWEET BOX: emptied " BOX_DONE_FILE ": %d\n", err);
+	if (!root) {
+		return;
+	}
+	char part[40];
+	box_part(part);
+	uint32_t nfiles = 0;
+	void *buf = box_read(part, &nfiles);
+	if (!buf) {
+		return;
+	}
+	unsigned total = 0;
+	box_root_installed = box_walk(buf, nfiles, true, &total);
+	printf("SWEET BOX: root pass, %u/%u files installed\n", box_root_installed, total);
+	kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+}
+
+void
+sweet_mailbox_probe(void)
+{
+	unsigned enabled = 0;
+	(void)PE_parse_boot_argn("sweetmailbox", &enabled, sizeof(enabled));
+	if (!enabled) return;
+	printf("SWEET BOX: enabled, will extract logdump -> /private/var/tmp/ after root mount\n");
+	thread_t t;
+	if (kernel_thread_start(box_thread, NULL, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
