+/* Alert slider: TLMM tile + 0x1000 * gpio; CTL at +0, IN_OUT at +4. */
+static struct {
+	uint32_t pa;
+	unsigned gpio;
+	vm_offset_t va;
+} slider_pin[3] = {
+	{ 0x03500000u + 0x1000u * 27u, 27, 0 },         /* key1 EAST: bottom (ring) */
+	{ 0x03d00000u + 0x1000u * 134u, 134, 0 },       /* key2 SOUTH: middle (vibrate) */
+	{ 0x03100000u + 0x1000u * 125u, 125, 0 },       /* key3 WEST: top (silent) */
+};
+static bool slider_ok, slider_invert;
+
+static void
+slider_init(void)
+{
+	int mode = 1;
+	(void)PE_parse_boot_argn("sweetslider", &mode, sizeof(mode));
+	if (!keys_guac || mode == 0) {
+		return;
+	}
+	slider_invert = mode == 2;
+	bool ok = true;
+	for (unsigned i = 0; i < 3; i++) {
+		slider_pin[i].va = ml_io_map(slider_pin[i].pa, 0x1000);
+		if (!slider_pin[i].va) {
+			ok = false;
+			continue;
+		}
+		uint32_t ctl = keys_rd(slider_pin[i].va, 0), io = keys_rd(slider_pin[i].va, 4);
+		/* CTL: [1:0] pull, [5:2] function (0 = GPIO), bit 9 output enable */
+		bool input = ((ctl >> 2) & 0xfu) == 0 && !(ctl & (1u << 9));
+		printf("SWEET SLIDER: gpio%u ctl %#x in %u -> %s\n", slider_pin[i].gpio, ctl, io & 1u,
+		    input ? "gpio input" : "NOT a gpio input; slider disabled");
+		ok = ok && input;
+	}
+	slider_ok = ok;
+}
+
+/* 0 ring (bottom), 1 vibrate (middle), 2 silent (top), -1 between positions. */
+static int
+slider_read(void)
+{
+	unsigned k1 = keys_rd(slider_pin[0].va, 4) & 1u;
+	unsigned k2 = keys_rd(slider_pin[1].va, 4) & 1u;
+	unsigned k3 = keys_rd(slider_pin[2].va, 4) & 1u;
+	if (k1 && k2 && !k3) {
+		return 2;
+	}
+	if (k1 && !k2 && k3) {
+		return 1;
+	}
+	if (!k1 && k2 && k3) {
+		return 0;
+	}
+	return -1;
+}
