+/*
+ * Ring/silent switch. iOS takes it as Telephony/RingEnable keyboard events
+ * (IOHIDFamily HIDButtonLoggingServiceFilter lists the pair as the ringer).
+ * ring != 0: ringing enabled (key down); 0: silent (key up). Returns false
+ * while the HID service is not registered yet so the caller can retry.
+ */
+extern "C" bool
+sweet_hid_ringer(int ring)
+{
+	if (!gSweetButtons) {
+		return false;
+	}
+	gSweetButtons->key(kHIDPage_Telephony, kHIDUsage_Tfon_RingEnable, ring != 0);
+	return true;
+}
+
+/* Open HID event clients of the button service (0 before backboardd). */
+extern "C" unsigned
+sweet_hid_button_clients(void)
+{
+	return gSweetButtons ? gSweetButtons->clientCount() : 0;
+}
