+	if (usb_guac && enabled >= 2) {
+		printf("SWEET USB: as found: GDSC 0x%08x master 0x%08x cfg-noc 0x%08x\n",
+		    usb_rd(gcc, GCC_USB30_PRIM_GDSCR), usb_rd(gcc, 0x0f010), usb_rd(gcc, 0x0f078));
+		usb_guac_power_up(gcc);
