+/*
+ * Nearest-neighbour scale of one layer from presented (logical) to panel
+ * coordinates. Panel row/column p shows logical p * L / P; repeated rows
+ * are copied from the panel row above.
+ */
+void
+AppleCLCD::presentStretched(SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	const int64_t lw = fLogicalW, lh = fLogicalH, pw = fWidth, ph = fHeight;
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)lw - dx) {
+		w = (int32_t)lw - dx;
+	}
+	if (h > (int32_t)lh - dy) {
+		h = (int32_t)lh - dy;
+	}
+	if (src == 0 || w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	int64_t px0 = (dx * pw + lw - 1) / lw, px1 = ((dx + w) * pw + lw - 1) / lw;
+	int64_t py0 = (dy * ph + lh - 1) / lh, py1 = ((dy + h) * ph + lh - 1) / lh;
+	px1 = px1 > pw ? pw : px1;
+	py1 = py1 > ph ? ph : py1;
+	if (px1 <= px0 || py1 <= py0) {
+		return;
+	}
+	const size_t bytes = (size_t)(px1 - px0) * 4;
+	int64_t prev = -1;
+	for (int64_t py = py0; py < py1; py++) {
+		int64_t ly = py * lh / ph;
+		uint32_t *dst = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes + (uint64_t)px0 * 4);
+		if (ly == prev) {
+			memcpy(dst, (const void *)((uintptr_t)dst - fRowBytes), bytes);
+			continue;
+		}
+		prev = ly;
+		const uint32_t *row = (const uint32_t *)(src + s->offset +
+		    (uint64_t)(sy + (ly - dy)) * s->bytesPerRow + (uint64_t)sx * 4);
+		for (int64_t px = px0; px < px1; px++) {
+			*dst++ = row[fColMap[px] - dx];
+		}
+	}
+}
