+}
+
+/*
+ * KGSL rpmh_arc_cmds(): an ARC resource's aux data is a zero-padded table
+ * of little-endian u16 voltage levels (VLVL); count up to the padding.
+ * Read only: no TCS is touched.
+ */
+static int
+rh_arc_levels(const char *res, uint16_t vals[16], unsigned *count)
+{
+	uint32_t address = 0;
+	int error = rh_lookup(res, RH_ARC, &address);
+	if (error) {
+		return error;
+	}
+	unsigned n = rh_aux_len / 2u;
+	if (n == 0 || n > 16) {
+		printf("SWEET RPMH: %s aux len %u unsupported\n", res, rh_aux_len);
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < 16; i++) {
+		vals[i] = i < n ? rh_db16(rh_aux_off + 2u * i) : 0;
+	}
+	unsigned num;
+	for (num = 1; num < n; num++) {
+		if (vals[num - 1] != 0 && vals[num] == 0) {
+			break;
+		}
+	}
+	*count = num;
+	printf("SWEET RPMH: %s %u levels:", res, num);
+	for (unsigned i = 0; i < num; i++) {
+		printf(" %u", vals[i]);
+	}
+	printf("\n");
+	return 0;
+}
+
+/* gfx.lvl / cx.lvl / mx.lvl for the GMU perf table; also logs the a640 BW BCMs. */
+int
+sweet_rpmh_gpu_arcs(uint16_t gfx[16], unsigned *ngfx, uint16_t cx[16], unsigned *ncx,
+    uint16_t mx[16], unsigned *nmx)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_poisoned ? EIO : rh_map();
+	if (!error) {
+		error = rh_arc_levels("gfx.lvl", gfx, ngfx);
+	}
+	if (!error) {
+		error = rh_arc_levels("cx.lvl", cx, ncx);
+	}
+	if (!error) {
+		error = rh_arc_levels("mx.lvl", mx, nmx);
+	}
+	if (!error) {
+		/* Cross-check mainline a640_build_bw_table's fixed BCM addresses. */
+		static const char *const bcm[] = { "ACV", "MC0", "SH0", "CN0", "QUP0", "SN11" };
+		for (unsigned i = 0; i < sizeof(bcm) / sizeof(bcm[0]); i++) {
+			uint32_t a = 0;
+			(void)rh_lookup(bcm[i], RH_BCM, &a);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
