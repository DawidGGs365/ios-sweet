+			int err = memorystatus_set_memlimit_properties(proc_getpid(p), &raised);
+			printf("SWEET MEM: %s[%d] over its limit: raised to 2048 MB, not fatal (%d)\n", name, proc_getpid(p), err);
+			if (err == 0) {
+				return;
+			}
+		}
+	}
+#endif
