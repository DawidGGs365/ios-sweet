 /*
+ * 0099: report ERROR_LOG / GLOB_IRQ_STTS whenever they change, tagged with
+ * the init step that just ran, to find where 0x4006010 (s0096/s0097) comes from.
+ */
+static void
+gpi_chk(const char *step)
+{
+	uint32_t err = touch_rd(gpi.regs, GPI_ERROR_LOG);
+	uint32_t glob = touch_rd(gpi.regs, GPI_GPII_REG(0x23100u));
+	if ((err != gpi.err_prev || glob != 0) && gpi.chk_logs < 24) {
+		gpi.chk_logs++;
+		touch_log("SWEET TOUCH: GPI chk %s: err-log %#x glob %#x type %#x src-ch %#x src-ev %#x ev %#x tx %#x rx %#x\n",
+		    step, err, glob, touch_rd(gpi.regs, GPI_GPII_REG(0x23080u)),
+		    touch_rd(gpi.regs, GPI_GPII_REG(0x23090u)), touch_rd(gpi.regs, GPI_GPII_REG(0x23094u)),
+		    touch_rd(gpi.regs, GPI_EV_CNTXT), touch_rd(gpi.regs, GPI_CH_CNTXT(0)),
+		    touch_rd(gpi.regs, GPI_CH_CNTXT(1)));
+	}
+	gpi.err_prev = err;
+}
