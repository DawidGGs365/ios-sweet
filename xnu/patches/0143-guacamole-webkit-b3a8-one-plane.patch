diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index fd9a8b781..5a3c85f55 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -378,6 +378,29 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 		}
 		s->planeCount = planes->getCount();
 	}
+	/*
+	 * 0143: a 'b3a8' made one-plane BGRA kept no plane at all, so IOSurfaceGetBytesPerRowOfPlane(0)
+	 * was 0 for it. WebKit's GPU process builds CGImages from plane 0 of its 'b3a8' tiles: 526
+	 * "CGImageCreate: invalid image bits/pixel or bytes/row" in one Safari session (jb1), pages
+	 * black. For WebKit's processes that plane is the whole BGRA surface (backboardd's GL path
+	 * keeps the plane-less layout it was written for).
+	 */
+	if (one_plane && s->planeCount == 0) {
+		char who[32] = "";
+		proc_selfname(who, sizeof(who));
+		if (strncmp(who, "com.apple.WebKit", 16) == 0) {
+			struct sweet_surface_plane *p = &s->planes[0];
+			p->width = s->width;
+			p->height = s->height;
+			p->bytesPerElement = s->bytesPerElement;
+			p->elementWidth = s->elementWidth;
+			p->elementHeight = s->elementHeight;
+			p->bytesPerRow = s->bytesPerRow;
+			p->offset = s->offset;
+			p->size = s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+			s->planeCount = 1;
+		}
+	}
 
 	uint64_t alloc = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
 	if (alloc < end) {
@@ -901,7 +924,16 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 	}
 	char wkname[32];
 	if (sweet_wk_proc(wkname, sizeof(wkname)) && sweet_wk_lines < 240) {
-		IOLog("SWEET SURF: wk %s asked fmt 0x%x\n", wkname, sweet_dict_u32(props, "IOSurfacePixelFormat", 0));
+		OSArray *pl = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+		OSDictionary *p0 = pl != NULL ? OSDynamicCast(OSDictionary, pl->getObject(0)) : NULL;
+		IOLog("SWEET SURF: wk %s asked fmt 0x%x %ux%u bpe %u bpr %u ew %u planes %u (0: bpe %u bpr %u %ux%u) -> bpe %u planes %u\n",
+		    wkname, sweet_dict_u32(props, "IOSurfacePixelFormat", 0), sweet_dict_u32(props, "IOSurfaceWidth", 0),
+		    sweet_dict_u32(props, "IOSurfaceHeight", 0), sweet_dict_u32(props, "IOSurfaceBytesPerElement", 0),
+		    sweet_dict_u32(props, "IOSurfaceBytesPerRow", 0), sweet_dict_u32(props, "IOSurfaceElementWidth", 0),
+		    pl != NULL ? pl->getCount() : 0, p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneBytesPerElement", 0) : 0,
+		    p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneBytesPerRow", 0) : 0,
+		    p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneWidth", 0) : 0,
+		    p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneHeight", 0) : 0, s->bytesPerElement, s->planeCount);
 	}
 	sweet_wk_log("create", s, ret);
 	props->release();
