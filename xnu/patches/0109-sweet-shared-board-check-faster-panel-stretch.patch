diff --color -ruN a/bsd/dev/sweet_board.c b/bsd/dev/sweet_board.c
--- a/bsd/dev/sweet_board.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_board.c	2026-11-06 13:59:01.402633497 +0100
@@ -0,0 +1,41 @@
+/*
+ * Board identity shared by the SWEET-config drivers: the guacamole ADT root
+ * lists "oneplus,guacamole" in /compatible (unixnu-guacamole
+ * make-guacamole-adt.py); sweet (Redmi Note 10 Pro) does not. The device
+ * tree is immutable after boot, so the answer is computed once.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+bool sweet_is_guacamole(void);
+
+static int sweet_board_guac = -1;       /* -1 unknown, 0 sweet, 1 guacamole */
+
+bool
+sweet_is_guacamole(void)
+{
+	int v = __atomic_load_n(&sweet_board_guac, __ATOMIC_RELAXED);
+	if (v >= 0) {
+		return v != 0;
+	}
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	v = 0;
+	if (SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+	    SecureDTGetProperty(root, "compatible", &prop, &size) == kSuccess) {
+		const char *c = (const char *)prop;
+		for (unsigned int i = 0; i < size && !v;) {
+			unsigned int n = (unsigned int)strnlen(c + i, size - i);
+			v = n == sizeof("oneplus,guacamole") - 1 &&
+			    strncmp(c + i, "oneplus,guacamole", n) == 0;
+			i += n + 1;
+		}
+	}
+	__atomic_store_n(&sweet_board_guac, v, __ATOMIC_RELAXED);
+	return v != 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
