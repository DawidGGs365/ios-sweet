 		    !rh_sync(cmd + RH_DATA, values[c])) {
 			return EIO;
 		}
 	}
-	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	if (!rh_sync(b + RH_WAIT, mask) || !rh_sync(b + RH_ENABLE, mask) ||
 	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
 		return EIO;
 	}
@@ -289,7 +295,7 @@
 		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
 		idle = rh_read(rh_tcs, b + RH_STATUS);
 		bool complete = true;
-		for (unsigned c = 0; c < 3; ++c) {
+		for (unsigned c = 0; c < n; ++c) {
 			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
 			complete &= status[c] != 0xffffffffu &&
 			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
@@ -320,7 +326,7 @@
 		return EIO;
 	}
 	rh_poisoned = false;
-	printf("SWEET RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	printf("SWEET RPMH: ACTIVE vote @%#x complete\n", address);
 	return 0;
 }
 
@@ -365,10 +371,13 @@
 	}
 	error = rh_map();
 	if (!error) {
-		error = rh_lookup(res, &address);
+		error = rh_lookup(res, RH_VRM, &address);
 	}
 	if (!error) {
-		error = rh_send(address, mv);
+		/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+		const uint32_t addrs[3] = {address, address + 8, address + 4};
+		const uint32_t values[3] = {mv, 7, 1};
+		error = rh_send(addrs, values, 3);
 	}
 out:
 	if (error) {
@@ -376,5 +385,47 @@
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
+}
+/*
+ * guacamole QUP2/GPI: mainline interconnect sm8150 puts qhm_qup2 behind
+ * BCM QUP0 (QUP core clocks) and qnm_aggre2_noc behind BCM SN11, neither
+ * keepalive. Linux (geni-se bus vote, mas 0x99 -> slv 0x200) votes them
+ * before every GSI transfer. One BCM command: commit|valid|x<<14|y.
+ */
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t vote_x, uint32_t vote_y)
+{
+	static const char *const allowed[] = { "QUP0", "SN11" };
+	bool ok = false;
+	for (unsigned i = 0; res != NULL && i < sizeof(allowed) / sizeof(allowed[0]); i++) {
+		ok |= strcmp(res, allowed[i]) == 0;
+	}
+	if (!ok || vote_x > 0x3fffu || vote_y > 0x3fffu) {
+		printf("SWEET RPMH: BCM %s %u/%u not allowed\n", res ? res : "(null)", vote_x, vote_y);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_BCM, &address);
+	}
+	if (!error) {
+		const uint32_t value = (1u << 30) | (1u << 29) | (vote_x << 14) | vote_y;
+		error = rh_send(&address, &value, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: BCM %s vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
