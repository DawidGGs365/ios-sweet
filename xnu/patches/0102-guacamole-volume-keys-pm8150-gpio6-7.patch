+static bool
+keys_is_guacamole(void)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *c = (const char *)prop;
+	for (unsigned int i = 0; i < size;) {
+		unsigned int n = 0;
+		while (i + n < size && c[i + n] != '\0') {
+			n++;
+		}
+		if (n == sizeof("oneplus,guacamole") - 1 && strncmp(c + i, "oneplus,guacamole", n) == 0) {
+			return true;
+		}
+		i += n + 1;
+	}
+	return false;
+}
+
+/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
+static bool
+keys_gpio_check(unsigned g)
+{
+	uint16_t b = keys_gpio[g].base, a = keys_gpio[g].apid;
+	uint8_t rt = 0, st = 0, mode = 0, en = 0, subtype = 0;
+	bool rok = keys_read(a, b + 0x10u, &rt);
+	bool tok = keys_read(a, b + 0x08u, &st);
+	bool mok = keys_read(a, b + 0x40u, &mode);
+	bool eok = keys_read(a, b + 0x46u, &en);
+	bool sok = keys_read(a, b + 0x05u, &subtype);
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ? mode & 3u : (mode >> 4) & 7u;
+	bool ok = rok && eok && mok && sok && (en & 0x80u) && (dir == 0 || dir == 2);
+	printf("SWEET KEYS: %s ppid %#x apid %u rt %#x/%d status1 %#x/%d mode %#x en %#x subtype %#x -> %s\n",
+	    keys_gpio[g].name, keys_gpio[g].ppid, a, rt, rok, st, tok, mode, en, subtype,
+	    ok ? "input" : "NOT confirmed input; withheld, PMIC unchanged");
+	return ok;
+}
