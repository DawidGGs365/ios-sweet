+/*
+ * 0110: s0105's first S1-translated DMA sent the SoC to crash-dump (EDL)
+ * with nothing logged. While probing, every doorbell is preceded by the
+ * SMMU fault state and a pause so the line leaves over USB before a
+ * possible fatal fault, and followed by the same state. Boot-arg
+ * sweetgpistop: 1 never rings a doorbell, 2 only the first one.
+ */
+static void
+gpi_smmu_state(const char *when)
+{
+	if (!st.probing || !gpi.cb || !gpi.smmu) {
+		return;
+	}
+	touch_log("SWEET TOUCH: GPI %s: gfsr %#x gfsynr0 %#x cb fsr %#x far 0x%08x%08x fsynr0 %#x err-log %#x\n", when,
+	    touch_rd(gpi.smmu, 0x48), touch_rd(gpi.smmu, 0x50), touch_rd(gpi.cb, 0x58),
+	    touch_rd(gpi.cb, 0x64), touch_rd(gpi.cb, 0x60), touch_rd(gpi.cb, 0x68),
+	    touch_rd(gpi.regs, GPI_ERROR_LOG));
+}
+
+static bool
+gpi_doorbell_allowed(const char *what)
+{
+	unsigned stop = 0;
+	(void)PE_parse_boot_argn("sweetgpistop", &stop, sizeof(stop));
+	if ((stop == 1) || (stop == 2 && gpi.doorbells >= 1)) {
+		touch_log("SWEET TOUCH: GPI sweetgpistop=%u: not ringing %s\n", stop, what);
+		return false;
+	}
+	if (st.probing && gpi.doorbells < 4) {
+		touch_log("SWEET TOUCH: GPI about to ring %s (doorbell %u)\n", what, gpi.doorbells + 1);
+		gpi_smmu_state("before doorbell");
+		delay(300000);                  /* let the USB log send these lines */
+	}
+	gpi.doorbells++;
+	return true;
+}
