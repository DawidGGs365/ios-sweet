+/* A 16-bit little-endian FG value and its shadow copy, read until they agree. */
+bool
+SweetBattery::readShadow(unsigned address, unsigned copy, uint16_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi, lo2, hi2;
+		if (sweet_spmi_read(2, address, &lo) || sweet_spmi_read(2, address + 1, &hi) ||
+		    sweet_spmi_read(2, copy, &lo2) || sweet_spmi_read(2, copy + 1, &hi2)) {
+			return false;
+		}
+		if (lo == lo2 && hi == hi2) {
+			*value = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+			return true;
+		}
+	}
+	return false;
+}
