+/*
+ * GUACAMOLE: cmd-db auxiliary data of one resource (any slave type), as
+ * the little-endian 16-bit words Linux's cmd_db_read_aux_data() returns:
+ * the ARC levels ("gfx.lvl", "cx.lvl", "mx.lvl") the GMU perf table needs.
+ * Read-only; no RSC traffic.
+ */
+int
+sweet_cmd_db_aux(const char *res, uint16_t *out, unsigned max, unsigned *count)
+{
+	int err = rh_map();
+	if (err) {
+		return err;
+	}
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned n = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, n * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < n; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t len = rh_db16(e + 20), off = aux + rh_db16(e + 22);
+			if ((len & 1u) || !rh_range(off, len)) {
+				return EINVAL;
+			}
+			unsigned words = len / 2u;
+			for (unsigned k = 0; k < words && k < max; ++k) {
+				out[k] = rh_db16(off + 2u * k);
+			}
+			*count = words < max ? words : max;
+			return 0;
+		}
+	}
+	return ENOENT;
+}
