+/*
+ * Stage 1 (boot-arg sweetgpu=3): boot the GMU (Cortex-M3 power manager)
+ * firmware and start its HFI queues, following Linux a6xx_gmu.c for a640
+ * (non-legacy GMU, PDC not in AOP): RSC/PDC sequencer setup
+ * (a6xx_gmu_rpmh_init), fw_start, gmu_start, hfi_start. GX stays off.
+ *
+ * Firmware: a640_gmu.bin from /sweet-gpu gmu-fw (mkadt.py copies it from the
+ * stock OxygenOS vendor/firmware at build time). Blocks for the ITCM/DTCM go
+ * in through GMU registers; the icache (GMU VA 0x4000) and dcache (0x44000)
+ * blocks live in RAM the GMU reaches through the GPU SMMU, so one context
+ * bank gets a small stage-1 table for the gmu_kernel stream (SID 5).
+ */
+#define GMU_ITCM                (0x0c00u << 2)
+#define GMU_DTCM                (0x1c00u << 2)
+#define GMU_TCM_SIZE            0x4000u
+#define GMU_CM3_BOOT_CONFIG     (0x5001u << 2)
+#define GMU_CM3_CFG             (0x502du << 2)
+#define GMU_PWR_COL_CP_MSG      (0x5100u << 2)
+#define GMU_PWR_COL_CP_RESP     (0x5101u << 2)
+#define GMU_PWR_COL_INTER_FRAME (0x50c0u << 2)
+#define GMU_RPMH_CTRL           (0x50e8u << 2)
+#define GMU_HFI_SFR_ADDR        (0x5182u << 2)
+#define GMU_HFI_QTBL_INFO       (0x5184u << 2)
+#define GMU_HFI_QTBL_ADDR       (0x5185u << 2)
+#define GMU_HFI_CTRL_INIT       (0x5186u << 2)
+#define GMU_GMU2HOST_INTR_MASK  (0x5193u << 2)
+#define GMU_ICACHE_CONFIG       (0x4c00u << 2)
+#define GMU_DCACHE_CONFIG       (0x4c01u << 2)
+#define GMU_SYS_BUS_CONFIG      (0x4c0fu << 2)
+#define GMU_AO_HOST_INT_MASK    (0x9306u << 2)
+#define GMU_RSCC_CONTROL_REQ    (0x9307u << 2)
+#define GMU_RSCC_CONTROL_ACK    (0x9308u << 2)
+#define GMU_AO_AHB_FENCE_RANGE0 (0x9311u << 2)
+/* RSCC: GMU block + 0x23000 (a640), dword offsets */
+#define RSCC(off)               (0x23000u + ((off) << 2))
+#define PDC_CFG_PA              0x0b290000u
+#define PDC_SEQ_PA              0x0b490000u
+#define PDC_SIZE                0x00010000u
+#define PDC(off)                ((off) << 2)
+#define PDC_ENABLE              0x1140u
+#define PDC_SEQ_START           0x1148u
+#define PDC_TCS1                0x1572u         /* CONTROL; +1 ENABLE_BANK, +2 WAIT; cmd n MSGID/ADDR/DATA at +3/+4/+5 + 4n */
+#define PDC_TCS3                0x15d6u
+#define A640_GMU_CHIPID         0x06040100u     /* chip 0x06040001 in the GMU layout */
+
+/* GMU-visible memory (Linux a6xx_gmu_memory_probe for non-a650 parts) */
+#define GVA_ICACHE              0x00004000u
+#define GVA_DCACHE              0x00044000u
+#define GVA_CACHE_SIZE          0x0003c000u     /* SZ_256K - SZ_16K */
+#define GVA_DUMMY               0x60000000u
+#define GVA_HFI                 0x60001000u
+#define GVA_LOG                 0x60005000u
+#define GVA_BUF_SIZE            0x4000u
+/* offsets in the one contiguous allocation */
+#define GM_L1                   0x00000u
+#define GM_L2A                  0x01000u
+#define GM_L3A                  0x02000u
+#define GM_L2B                  0x03000u
+#define GM_L3B                  0x04000u
+#define GM_ICACHE               0x10000u
+#define GM_DCACHE               0x50000u
+#define GM_DUMMY                0x90000u
+#define GM_HFI                  0x91000u
+#define GM_LOG                  0x95000u
+#define GM_SIZE                 0x100000u
+
+static vm_offset_t gm_va;
+static uint64_t gm_pa;
+
+static bool
+gpu_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms * 10u; i++) {
+		if ((gpu_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
+/* 4 KiB stage-1 page: AF, inner shareable, EL0+EL1 RW, nG, MAIR index 0 (normal non-cacheable). */
+static void
+gm_map(uint32_t gva, uint32_t off, uint32_t size)
+{
+	uint64_t *l3 = (uint64_t *)(gm_va + (gva < 0x40000000u ? GM_L3A : GM_L3B));
+	for (uint32_t o = 0; o < size; o += 0x1000u) {
+		l3[((gva + o) >> 12) & 0x1ffu] = (gm_pa + off + o) | 3u | (1u << 10) | (3u << 8) | (1u << 6) | (1u << 11);
+	}
+}
+
+static bool
+gm_alloc(void)
+{
+	if (kmem_alloc_contig(kernel_map, &gm_va, GM_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)gm_va);
+	if (!pn) {
+		return false;
+	}
+	gm_pa = ptoa_64(pn);
+	uint64_t *l1 = (uint64_t *)(gm_va + GM_L1);
+	uint64_t *l2a = (uint64_t *)(gm_va + GM_L2A), *l2b = (uint64_t *)(gm_va + GM_L2B);
+	l1[0] = (gm_pa + GM_L2A) | 3u;                          /* 0x00000000-0x3fffffff */
+	l1[GVA_DUMMY >> 30] = (gm_pa + GM_L2B) | 3u;            /* 0x40000000-0x7fffffff */
+	l2a[0] = (gm_pa + GM_L3A) | 3u;
+	l2b[(GVA_DUMMY >> 21) & 0x1ffu] = (gm_pa + GM_L3B) | 3u;
+	gm_map(GVA_ICACHE, GM_ICACHE, GVA_CACHE_SIZE);
+	gm_map(GVA_DCACHE, GM_DCACHE, GVA_CACHE_SIZE);
+	gm_map(GVA_DUMMY, GM_DUMMY, 0x1000u);
+	gm_map(GVA_HFI, GM_HFI, GVA_BUF_SIZE);
+	gm_map(GVA_LOG, GM_LOG, GVA_BUF_SIZE);
+	return true;
+}
+
+/*
+ * HFI queue table (Linux a6xx_hfi_init): 6-word table header, two 12-word
+ * queue headers, command queue (id 0) and response queue (id 4), 4 KiB each.
+ */
+static void
+gm_hfi_table(void)
+{
+	uint32_t *t = (uint32_t *)(gm_va + GM_HFI);
+	t[0] = 0;                       /* version */
+	t[1] = (6 + 2 * 12);            /* size, dwords */
+	t[2] = 6;                       /* qhdr0 offset, dwords */
+	t[3] = 12;                      /* qhdr size, dwords */
+	t[4] = 2;                       /* num queues */
+	t[5] = 2;                       /* active queues */
+	for (unsigned q = 0; q < 2; q++) {
+		uint32_t *h = t + 6 + 12 * q;
+		h[0] = 1;                                       /* status: enabled */
+		h[1] = GVA_HFI + 0x1000u * (q + 1);             /* queue iova */
+		h[2] = (10u << 8) | (q ? 4u : 0u);              /* type: priority 10, id */
+		h[3] = 0x1000u >> 2;                            /* size, dwords */
+		h[6] = 1;                                       /* rx watermark */
+		h[7] = 1;                                       /* tx watermark */
+		h[8] = 1;                                       /* rx request */
+	}
+}
+
+static int gm_smmu_cb = -1;
+static vm_offset_t gm_smmu, gm_cb;
+
+/* Route the gmu_kernel stream (SID 5, mask 0x400) to a stage-1 context bank over gm_pa tables. */
+static bool
+gm_smmu_setup(void)
+{
+	gm_smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!gm_smmu) {
+		return false;
+	}
+	uint32_t idr0 = gpu_rd(gm_smmu, 0x20), idr1 = gpu_rd(gm_smmu, 0x24);
+	uint32_t pagesize = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	uint32_t numpage = 1u << (((idr1 >> 28) & 7u) + 1u);
+	uint32_t nsmr = idr0 & 0xffu, ncb = idr1 & 0xffu;
+	if ((uint64_t)pagesize * numpage * 2u > SMMU_SIZE || nsmr > 128u || ncb > 32u) {
+		printf("SWEET GPU: S1 SMMU layout unexpected (IDR0 0x%08x IDR1 0x%08x)\n", idr0, idr1);
+		return false;
+	}
+	vm_offset_t gr1 = gm_smmu + pagesize, cbase = gm_smmu + (vm_offset_t)pagesize * numpage;
+	int smr_idx = -1, free_smr = -1;
+	uint32_t cb_used = 0;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = gpu_rd(gm_smmu, 0x800 + 4 * i), s2cr = gpu_rd(gm_smmu, 0xc00 + 4 * i);
+		if (!(smr & (1u << 31))) {
+			if (free_smr < 0) {
+				free_smr = (int)i;
+			}
+			continue;
+		}
+		uint32_t mask = (smr >> 16) & 0x7fffu;
+		if (((smr ^ 5u) & ~mask & 0x7fffu) == 0 && smr_idx < 0) {
+			smr_idx = (int)i;       /* reuse the group the boot firmware set up for SID 5 */
+			continue;
+		}
+		if (((s2cr >> 16) & 3u) == 0) {
+			cb_used |= 1u << (s2cr & 0x1fu);
+		}
+	}
+	if (smr_idx < 0) {
+		smr_idx = free_smr;
+	}
+	for (uint32_t n = ncb; n-- > 0;) {      /* highest free bank: low ones are the usual GPU user/secure banks */
+		if (!(cb_used & (1u << n)) && !(gpu_rd(cbase + (vm_offset_t)n * pagesize, 0x0) & 1u)) {
+			gm_smmu_cb = (int)n;
+			break;
+		}
+	}
+	if (smr_idx < 0 || gm_smmu_cb < 0) {
+		printf("SWEET GPU: S1 no free SMMU stream group (%d) or context bank (%d)\n", smr_idx, gm_smmu_cb);
+		return false;
+	}
+	gm_cb = cbase + (vm_offset_t)gm_smmu_cb * pagesize;
+	uint32_t n = (uint32_t)gm_smmu_cb;
+
+	/* Stage-1 tables are walked from memory: clean them to the point of coherency first. */
+	flush_dcache64((addr64_t)gm_pa, 0x5000u, TRUE);
+
+	gpu_wr(gm_cb, 0x0, 0);                                         /* SCTLR off while programming */
+	gpu_wr(gr1, 4 * n, (1u << 16) | (3u << 8) | (0xfu << 12));     /* CBAR: S1 trans/S2 bypass, BPSHCFG NSH, WB */
+	gpu_wr(gr1, 0x800 + 4 * n, 1u);                                /* CBA2R: AArch64 */
+	gpu_wr(gm_cb, 0x10, 2u | (1u << 4));                           /* TCR2: 40-bit PA, 16-bit ASID */
+	gpu_wr(gm_cb, 0x20, (uint32_t)(gm_pa + GM_L1));                /* TTBR0 */
+	gpu_wr(gm_cb, 0x24, (uint32_t)((gm_pa + GM_L1) >> 32) | (0x51u << 16));
+	gpu_wr(gm_cb, 0x28, 0);                                        /* TTBR1 */
+	gpu_wr(gm_cb, 0x2c, 0);
+	gpu_wr(gm_cb, 0x30, 32u | (1u << 23));                         /* TCR: T0SZ 32, 4K, non-cacheable walks, EPD1 */
+	gpu_wr(gm_cb, 0x38, 0x0004ff44u);                              /* MAIR0: 0 NC, 1 WB, 2 device */
+	gpu_wr(gm_cb, 0x3c, 0);
+	gpu_wr(gm_cb, 0x58, gpu_rd(gm_cb, 0x58));                      /* clear FSR */
+	gpu_wr(gm_cb, 0x618, 0);                                       /* TLBIALL */
+	gpu_wr(gm_cb, 0x7f0, 0);                                       /* TLBSYNC */
+	(void)gpu_poll(gm_cb, 0x7f4, 1u, 0, 10);
+	gpu_wr(gm_cb, 0x0, 1u | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 6) | (1u << 12)); /* M TRE AFE CFRE CFIE ASIDPNE */
+	gpu_wr(gm_smmu, 0xc00 + 4 * (uint32_t)smr_idx, n);            /* S2CR: translate via cb n */
+	gpu_wr(gm_smmu, 0x800 + 4 * (uint32_t)smr_idx, (1u << 31) | (0x400u << 16) | 5u);
+	uint32_t scr0 = gpu_rd(gm_smmu, 0x0);
+	if (scr0 & 1u) {
+		/* CLIENTPD: the SMMU was bypassing everything; unmatched streams keep bypassing (USFCFG 0). */
+		gpu_wr(gm_smmu, 0x0, scr0 & ~1u & ~(1u << 10));
+	}
+	gpu_wr(gm_smmu, 0x68, 0);                                      /* TLBIALLNSNH */
+	gpu_wr(gm_smmu, 0x70, 0);                                      /* TLBGSYNC */
+	(void)gpu_poll(gm_smmu, 0x74, 1u, 0, 10);
+	printf("SWEET GPU: S1 SMMU smr%d -> cb%d ttbr 0x%llx sCR0 0x%08x->0x%08x sctlr 0x%08x\n",
+	    smr_idx, gm_smmu_cb, gm_pa + GM_L1, scr0, gpu_rd(gm_smmu, 0x0), gpu_rd(gm_cb, 0x0));
+	return true;
+}
+
+static void
+gm_smmu_fault_report(const char *when)
+{
+	if (gm_cb) {
+		printf("SWEET GPU: S1 %s: cb%d FSR 0x%08x FAR 0x%08x%08x FSYNR0 0x%08x sGFSR 0x%08x\n", when, gm_smmu_cb,
+		    gpu_rd(gm_cb, 0x58), gpu_rd(gm_cb, 0x64), gpu_rd(gm_cb, 0x60), gpu_rd(gm_cb, 0x68),
+		    gpu_rd(gm_smmu, 0x48));
+	}
+}
+
+/* Linux a6xx_gmu_rpmh_init (a640: PDC sequencer in the GPU PDC, pdc_address_offset 0x30090) */
+static bool
+gm_rpmh_init(void)
+{
+	vm_offset_t pdc = ml_io_map(PDC_CFG_PA, PDC_SIZE), seq = ml_io_map(PDC_SEQ_PA, PDC_SIZE);
+	if (!pdc || !seq) {
+		return false;
+	}
+	gpu_wr(g_gmu, RSCC(0x004), 1u << 24);                  /* RSC_STATUS0_DRV0: disable SDE clock gating */
+	gpu_wr(g_gmu, RSCC(0x00b), 1);                         /* PDC_SLAVE_ID_DRV0 */
+	gpu_wr(g_gmu, RSCC(0x00e), 0);                         /* HIDDEN_TCS_CMD0_DATA */
+	gpu_wr(g_gmu, RSCC(0x00d), 0);                         /* HIDDEN_TCS_CMD0_ADDR */
+	gpu_wr(g_gmu, RSCC(0x010), 0);
+	gpu_wr(g_gmu, RSCC(0x00f), 0);
+	gpu_wr(g_gmu, RSCC(0x012), 0x80000000u);
+	gpu_wr(g_gmu, RSCC(0x011), 0);
+	gpu_wr(g_gmu, RSCC(0x100), 0);                         /* OVERRIDE_START_ADDR */
+	gpu_wr(g_gmu, RSCC(0x008), 0x4520);                    /* PDC_SEQ_START_ADDR */
+	gpu_wr(g_gmu, RSCC(0x009), 0x4510);                    /* PDC_MATCH_VALUE_LO */
+	gpu_wr(g_gmu, RSCC(0x00a), 0x4514);                    /* PDC_MATCH_VALUE_HI */
+	static const uint32_t rsc_seq[] = { 0xa7a506a0, 0xa1e6a6e7, 0xa2e081e1, 0xe9a982e2, 0x0020e8a8 };
+	for (unsigned i = 0; i < 5; i++) {
+		gpu_wr(g_gmu, RSCC(0x180 + i), rsc_seq[i]);     /* SEQ_MEM_0_DRV0 */
+	}
+	static const uint32_t pdc_seq[] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	for (unsigned i = 0; i < 5; i++) {
+		gpu_wr(seq, PDC(i), pdc_seq[i]);                /* PDC_GPU_SEQ_MEM_0 */
+	}
+	/* TCS1: sleep votes; TCS3: wake votes (MSGID, ADDR, DATA per command; commands 4 registers apart) */
+	static const uint32_t tcs1[] = { 0x10108, 0x30010, 1, 0x10108, 0x30000, 0, 0x10108, 0x30090, 0 };
+	static const uint32_t tcs3[] = { 0x10108, 0x30010, 2, 0x10108, 0x30000, 3, 0x10108, 0x30090, 3 };
+	gpu_wr(pdc, PDC(PDC_TCS1 + 1), 7);
+	gpu_wr(pdc, PDC(PDC_TCS1 + 2), 0);
+	gpu_wr(pdc, PDC(PDC_TCS1), 0);
+	for (unsigned i = 0; i < 9; i++) {
+		gpu_wr(pdc, PDC(PDC_TCS1 + 3 + 4 * (i / 3) + i % 3), tcs1[i]);
+	}
+	gpu_wr(pdc, PDC(PDC_TCS3 + 1), 7);
+	gpu_wr(pdc, PDC(PDC_TCS3 + 2), 0);
+	gpu_wr(pdc, PDC(PDC_TCS3), 0);
+	for (unsigned i = 0; i < 9; i++) {
+		gpu_wr(pdc, PDC(PDC_TCS3 + 3 + 4 * (i / 3) + i % 3), tcs3[i]);
+	}
+	gpu_wr(pdc, PDC(PDC_SEQ_START), 0);
+	gpu_wr(pdc, PDC(PDC_ENABLE), 0x80000001u);
+	/* a6xx_rpmh_stop */
+	gpu_wr(g_gmu, GMU_RSCC_CONTROL_REQ, 1);
+	bool ok = gpu_poll(g_gmu, RSCC(0x004), 1u << 16, 1u << 16, 10);
+	gpu_wr(g_gmu, GMU_RSCC_CONTROL_REQ, 0);
+	printf("SWEET GPU: S1 RSC/PDC programmed, RSC power-off %s (status 0x%08x)\n", ok ? "ok" : "TIMEOUT",
+	    gpu_rd(g_gmu, RSCC(0x004)));
+	return true;
+}
+
+static bool
+gm_fw_load(const uint8_t *fw, uint32_t len)
+{
+	unsigned n_tcm = 0, n_mem = 0, n_skip = 0;
+	uint32_t pos = 0;
+	while (pos + 16u <= len) {
+		uint32_t addr, size;
+		memcpy(&addr, fw + pos, 4);
+		memcpy(&size, fw + pos + 4, 4);
+		const uint8_t *data = fw + pos + 16;
+		if (size > len - pos - 16u || (size & 3u)) {
+			printf("SWEET GPU: S1 bad firmware block at %#x (addr %#x size %#x)\n", pos, addr, size);
+			return false;
+		}
+		pos += 16u + size;
+		if (size == 0) {
+			continue;
+		}
+		uint32_t reg = 0;
+		vm_offset_t mem = 0;
+		if (addr < GMU_TCM_SIZE && size <= GMU_TCM_SIZE - addr) {
+			reg = GMU_ITCM + addr;
+		} else if (addr >= 0x40000u && addr - 0x40000u < GMU_TCM_SIZE && size <= GMU_TCM_SIZE - (addr - 0x40000u)) {
+			reg = GMU_DTCM + (addr - 0x40000u);
+		} else if (addr >= GVA_ICACHE && addr - GVA_ICACHE < GVA_CACHE_SIZE && size <= GVA_CACHE_SIZE - (addr - GVA_ICACHE)) {
+			mem = gm_va + GM_ICACHE + (addr - GVA_ICACHE);
+		} else if (addr >= GVA_DCACHE && addr - GVA_DCACHE < GVA_CACHE_SIZE && size <= GVA_CACHE_SIZE - (addr - GVA_DCACHE)) {
+			mem = gm_va + GM_DCACHE + (addr - GVA_DCACHE);
+		} else {
+			printf("SWEET GPU: S1 firmware block addr %#x size %#x not placed\n", addr, size);
+			n_skip++;
+			continue;
+		}
+		if (reg) {
+			for (uint32_t o = 0; o < size; o += 4) {
+				uint32_t w;
+				memcpy(&w, data + o, 4);
+				*(volatile uint32_t *)(g_gmu + reg + o) = w;
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			n_tcm++;
+		} else {
+			memcpy((void *)mem, data, size);
+			n_mem++;
+		}
+	}
+	flush_dcache64((addr64_t)(gm_pa + GM_ICACHE), GM_SIZE - GM_ICACHE, TRUE);
+	printf("SWEET GPU: S1 firmware %u bytes: %u TCM blocks, %u SMMU blocks, %u skipped, DTCM ver 0x%08x\n",
+	    len, n_tcm, n_mem, n_skip, gpu_rd(g_gmu, GMU_DTCM + 0x3fe0));
+	return n_tcm > 0;
+}
+
+static void
+gpu_stage1(void)
+{
+	DTEntry node;
+	const uint8_t *fw = NULL;
+	unsigned int fw_len = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "gmu-fw", (void const **)&fw, &fw_len) != kSuccess || fw_len < 32) {
+		printf("SWEET GPU: S1 no /sweet-gpu gmu-fw in the device tree (image built without OTA firmware)\n");
+		return;
+	}
+	if (!gm_alloc()) {
+		printf("SWEET GPU: S1 GMU memory allocation failed\n");
+		return;
+	}
+	gm_hfi_table();
+	printf("SWEET GPU: S1 GMU memory at 0x%llx, gmu-fw %u bytes\n", gm_pa, fw_len);
+	if (!gm_smmu_setup()) {
+		return;
+	}
+	/* Interrupts are polled: mask both GMU interrupt sources. */
+	gpu_wr(g_gmu, GMU_GMU2HOST_INTR_MASK, 0xffffffffu);
+	gpu_wr(g_gmu, GMU_AO_HOST_INT_MASK, 0xffffffffu);
+	if (!gm_rpmh_init()) {
+		printf("SWEET GPU: S1 PDC map failed\n");
+		return;
+	}
+	/* a6xx_gmu_fw_start, cold boot */
+	gpu_wr(g_gmu, GMU_GENERAL_7, 1);                        /* TCM retention */
+	gpu_wr(g_gmu, GMU_RSCC_CONTROL_REQ, 1u << 1);           /* a6xx_rpmh_start */
+	bool rsc = gpu_poll(g_gmu, GMU_RSCC_CONTROL_ACK, 1u << 1, 1u << 1, 10) &&
+	    gpu_poll(g_gmu, RSCC(0x101), 0xffffffffu, 0, 10);
+	gpu_wr(g_gmu, GMU_RSCC_CONTROL_REQ, 0);
+	printf("SWEET GPU: S1 RSC wake %s (ack 0x%08x seq-busy 0x%08x)\n", rsc ? "ok" : "TIMEOUT",
+	    gpu_rd(g_gmu, GMU_RSCC_CONTROL_ACK), gpu_rd(g_gmu, RSCC(0x101)));
+	if (!rsc || !gm_fw_load(fw, fw_len)) {
+		return;
+	}
+	gpu_wr(g_gmu, GMU_CM3_FW_INIT_RESULT, 0);
+	gpu_wr(g_gmu, GMU_CM3_BOOT_CONFIG, 2);
+	gpu_wr(g_gmu, GMU_HFI_QTBL_ADDR, GVA_HFI);
+	gpu_wr(g_gmu, GMU_HFI_QTBL_INFO, 1);
+	gpu_wr(g_gmu, GMU_AO_AHB_FENCE_RANGE0, (1u << 31) | (0xau << 18) | 0xa0u);
+	gpu_wr(g_gmu, GMU_CM3_CFG, 0x4052);
+	gpu_wr(g_gmu, GMU_HFI_SFR_ADDR, A640_GMU_CHIPID);
+	gpu_wr(g_gmu, GMU_PWR_COL_CP_MSG, GVA_LOG | (GVA_BUF_SIZE / 0x1000u - 1u));
+	/* a6xx_gmu_power_config, idle level ACTIVE (no IFPC/SPTP collapse) */
+	gpu_wr(g_gmu, GMU_SYS_BUS_CONFIG, 1);
+	gpu_wr(g_gmu, GMU_ICACHE_CONFIG, 1);
+	gpu_wr(g_gmu, GMU_DCACHE_CONFIG, 1);
+	gpu_wr(g_gmu, GMU_PWR_COL_INTER_FRAME, 0x9c40400);
+	gpu_wr(g_gmu, GMU_RPMH_CTRL, gpu_rd(g_gmu, GMU_RPMH_CTRL) | 0x1u | 0x10u | 0x100u | 0x200u | 0x400u | 0x800u);
+	/* a6xx_gmu_start */
+	uint32_t ver = gpu_rd(g_gmu, GMU_DTCM + 0x3fe0);
+	uint32_t mask = ver <= 0x20010004u ? 0xffffffffu : 0x1ffu, want = ver <= 0x20010004u ? 0xbabefaceu : 0x100u;
+	gpu_wr(g_gmu, GMU_CM3_SYSRESET, 1);
+	gpu_wr(g_gmu, GMU_PWR_COL_CP_RESP, 0);
+	gpu_wr(g_gmu, GMU_CM3_SYSRESET, 0);
+	bool up = gpu_poll(g_gmu, GMU_CM3_FW_INIT_RESULT, mask, want, 1000);
+	printf("SWEET GPU: S1 GMU %s: fw-init 0x%08x (want 0x%x/0x%x) rpmh-state 0x%08x\n", up ? "BOOTED" : "boot TIMEOUT",
+	    gpu_rd(g_gmu, GMU_CM3_FW_INIT_RESULT), want, mask, gpu_rd(g_gmu, GMU_CX_RPMH_POWER_STATE));
+	gm_smmu_fault_report("after GMU boot");
+	if (!up) {
+		return;
+	}
+	/* a6xx_gmu_hfi_start */
+	gpu_wr(g_gmu, GMU_HFI_CTRL_INIT, 1);
+	bool hfi = gpu_poll(g_gmu, GMU_HFI_CTRL_STATUS, 1u, 1u, 1000);
+	printf("SWEET GPU: S1 HFI %s (status 0x%08x); stage 1 done\n", hfi ? "STARTED" : "start TIMEOUT",
+	    gpu_rd(g_gmu, GMU_HFI_CTRL_STATUS));
+	gm_smmu_fault_report("after HFI start");
+}
