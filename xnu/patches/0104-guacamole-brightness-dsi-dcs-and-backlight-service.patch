diff --color -ruN a/bsd/dev/sweet_dsi.c b/bsd/dev/sweet_dsi.c
--- a/bsd/dev/sweet_dsi.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_dsi.c	2026-11-06 13:16:55.804127707 +0100
@@ -0,0 +1,215 @@
+/*
+ * guacamole panel commands over DSI0 (0xae94000): Samsung S6E3HC2 "samsung
+ * dsc cmd mode oneplus dsi panel" (stock dtbo 18821), command mode + DSC,
+ * left running by UEFI. Commands go through the DSI test-pattern-generator
+ * DMA FIFO exactly like Linux dsi_ctrl_hw_cmn_kickoff_fifo_command(): no
+ * command buffer in memory, so no SMMU mapping is involved.
+ *
+ * Brightness: DCS 0x51 with a 2-byte big-endian level (bl_ctrl_dcs),
+ * 1..0x3ff normal range (qcom,mdss-dsi-bl-normal-max-level). HBM levels
+ * above 0x3ff are refused here.
+ *
+ * boot-arg sweetbl=N (1..1023): set brightness N once, 60 s after boot,
+ * to verify the path without the GUI. sweetdsi=0 disables all DSI writes.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_dsi_set_brightness(unsigned level);
+void sweet_dsi_init(void);
+
+#define DSI0_PA                 0x0ae94000u
+#define DSI_HW_VERSION          0x000u
+#define DSI_CTRL                0x004u
+#define DSI_CMD_DMA_CTRL        0x03cu
+#define DSI_DMA_CMD_LENGTH      0x04cu
+#define DSI_CMD_DMA_SW_TRIGGER  0x090u
+#define DSI_INT_CTRL            0x110u
+#define DSI_TPG_CTRL            0x15cu
+#define DSI_TPG_CMD_DMA_INIT    0x17cu
+#define DSI_TPG_FIFO_STATUS     0x1dcu
+#define DSI_TPG_FIFO_RESET      0x1ecu
+
+static vm_offset_t d_base;
+static bool d_ok, d_dead;
+static unsigned d_lock;
+static int d_sleep_chan;
+
+static uint32_t
+dsi_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(d_base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+dsi_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(d_base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+dsi_is_guacamole(void)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *c = (const char *)prop;
+	for (unsigned int i = 0; i < size;) {
+		unsigned int n = 0;
+		while (i + n < size && c[i + n] != '\0') {
+			n++;
+		}
+		if (n == sizeof("oneplus,guacamole") - 1 && strncmp(c + i, "oneplus,guacamole", n) == 0) {
+			return true;
+		}
+		i += n + 1;
+	}
+	return false;
+}
+
+static bool
+dsi_setup(void)
+{
+	int enabled = 1;
+	(void)PE_parse_boot_argn("sweetdsi", &enabled, sizeof(enabled));
+	if (!enabled || !dsi_is_guacamole()) {
+		return false;
+	}
+	if (!d_base) {
+		d_base = ml_io_map(DSI0_PA, 0x400);
+	}
+	if (!d_base) {
+		return false;
+	}
+	uint32_t ver = dsi_rd(DSI_HW_VERSION), ctrl = dsi_rd(DSI_CTRL);
+	/* DSI_CTRL bit0 controller enable, bit2 command mode enable. */
+	d_ok = ver != 0 && ver != 0xffffffffu && (ctrl & 1u) && (ctrl & 4u);
+	printf("SWEET DSI: dsi0 version %#x ctrl %#x dma-ctrl %#x int %#x tpg %#x -> %s\n",
+	    ver, ctrl, dsi_rd(DSI_CMD_DMA_CTRL), dsi_rd(DSI_INT_CTRL), dsi_rd(DSI_TPG_CTRL),
+	    d_ok ? "command mode, usable" : "not in command mode; no writes");
+	return d_ok;
+}
+
+/*
+ * Send one embedded-mode packet (Qualcomm header byte order: data0/wc_lo,
+ * data1/wc_hi, vc<<6|dtype, flags bit6 long, bit7 last) through the TPG
+ * FIFO. words: header + payload dwords, at most 64 bytes.
+ */
+static int
+dsi_send(const uint32_t *words, unsigned n)
+{
+	if (!d_ok || d_dead || n == 0 || n > 16) {
+		return ENODEV;
+	}
+	if (__atomic_exchange_n(&d_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	uint32_t dma_ctrl = dsi_rd(DSI_CMD_DMA_CTRL);
+	uint32_t intr = dsi_rd(DSI_INT_CTRL);
+	/* Clear only CMD_MODE_DMA_DONE (bit 0); keep every mask/enable (odd bits). */
+	dsi_wr(DSI_INT_CTRL, (intr & 0xaaaaaaaau) | 1u);
+	/* CMD_DMA_TPG_EN | TPG_DMA_FIFO_MODE | CMD_DMA_PATTERN_SEL custom */
+	dsi_wr(DSI_TPG_CTRL, (1u << 1) | (1u << 2) | (3u << 16));
+	for (unsigned i = 0; i < n; i++) {
+		dsi_wr(DSI_TPG_CMD_DMA_INIT, words[i]);
+	}
+	if (n & 1u) {
+		dsi_wr(DSI_TPG_CMD_DMA_INIT, 0);        /* HW needs an even dword count */
+	}
+	/* EMBEDDED_MODE (bit 28), no broadcast, high-speed (bit 26 clear) like Linux backlight. */
+	dsi_wr(DSI_CMD_DMA_CTRL, (dma_ctrl & ~((1u << 31) | (1u << 30) | (1u << 26))) | (1u << 28));
+	dsi_wr(DSI_DMA_CMD_LENGTH, n * 4u);
+	dsi_wr(DSI_CMD_DMA_SW_TRIGGER, 1);
+	bool done = false;
+	for (unsigned i = 0; i < 5000 && !done; i++) {   /* Linux DSI_CTRL_TX_TO_MS 1200; 50 ms here */
+		done = (dsi_rd(DSI_INT_CTRL) & 1u) != 0;
+		if (!done) {
+			delay(10);
+		}
+	}
+	uint32_t fifo = dsi_rd(DSI_TPG_FIFO_STATUS);
+	/* dsi_ctrl_hw_cmn_reset_cmd_fifo() */
+	dsi_wr(DSI_TPG_CTRL, 0);
+	dsi_wr(DSI_TPG_FIFO_RESET, 1);
+	delay(1);
+	dsi_wr(DSI_TPG_FIFO_RESET, 0);
+	dsi_wr(DSI_INT_CTRL, (dsi_rd(DSI_INT_CTRL) & 0xaaaaaaaau) | 1u);
+	dsi_wr(DSI_CMD_DMA_CTRL, dma_ctrl);
+	if (!done) {
+		/* Never retry blindly: a stuck DMA engine could fight UEFI's scanout. */
+		d_dead = true;
+		printf("SWEET DSI: command DMA not done (int %#x fifo %#x); DSI writes disabled\n",
+		    dsi_rd(DSI_INT_CTRL), fifo);
+	}
+	__atomic_store_n(&d_lock, 0, __ATOMIC_RELEASE);
+	return done ? 0 : ETIMEDOUT;
+}
+
+int
+sweet_dsi_set_brightness(unsigned level)
+{
+	if (level < 1 || level > 0x3ff) {
+		return EINVAL;
+	}
+	if (!d_ok && !dsi_setup()) {
+		return ENODEV;
+	}
+	/* DCS long write (0x39), 3 bytes: 0x51 hi lo; last command; pad 0xff. */
+	const uint32_t words[2] = {
+		(1u << 31) | (1u << 30) | (0x39u << 16) | 3u,
+		0xff000000u | ((level & 0xffu) << 16) | (((level >> 8) & 0xffu) << 8) | 0x51u,
+	};
+	int err = dsi_send(words, 2);
+	static unsigned logged;
+	if (err || logged < 8) {
+		logged++;
+		printf("SWEET DSI: brightness %u -> err %d\n", level, err);
+	}
+	return err;
+}
+
+static void
+dsi_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	unsigned level = (unsigned)(uintptr_t)arg;
+	uint64_t deadline;
+	clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&d_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	(void)sweet_dsi_set_brightness(level);
+}
+
+void
+sweet_dsi_init(void)
+{
+	if (!dsi_setup()) {
+		return;
+	}
+	unsigned level = 0;
+	(void)PE_parse_boot_argn("sweetbl", &level, sizeof(level));
+	if (level >= 1 && level <= 0x3ff) {
+		thread_t thread;
+		if (kernel_thread_start(dsi_thread, (void *)(uintptr_t)level, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
