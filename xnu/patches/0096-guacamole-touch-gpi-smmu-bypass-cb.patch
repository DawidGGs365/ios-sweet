+	uint32_t cbar = touch_rd(gr1, 4 * cb), sctlr = touch_rd(cbr, 0x0);
+	bool ok = ((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) == cb && smr == ((1u << 31) | GPI_SID) &&
