+/* S6SY761 (Linux s6sy761.c / OnePlus sec_drivers_s6sy761.c event format). */
+static uint32_t s6_mask;
+static int s6_x[TOUCH_MAX], s6_y[TOUCH_MAX];
+
+static void
+touch_s6_events(const uint8_t *ev, unsigned n)
+{
+	for (unsigned i = 0; i < n; ++i, ev += 8) {
+		if (!ev[0]) {
+			break;
+		}
+		if ((ev[0] & 3u) != 0) {
+			continue; /* status / vendor event, not a coordinate */
+		}
+		unsigned tid = (ev[0] >> 2) & 0x0fu;
+		if (tid == 0 || tid > TOUCH_MAX) {
+			continue;
+		}
+		tid -= 1;
+		unsigned state = ev[0] >> 6;
+		if (state == 1 || state == 2) { /* press / move */
+			s6_mask |= 1u << tid;
+			s6_x[tid] = (ev[1] << 4) | (ev[3] >> 4);
+			s6_y[tid] = (ev[2] << 4) | (ev[3] & 0x0fu);
+		} else if (state == 3) { /* release */
+			s6_mask &= ~(1u << tid);
+		}
+	}
+}
+
+static int
+touch_s6(void)
+{
+	uint8_t ev[8 * TOUCH_MAX];
+	int err = touch_read(GUAC_ADDR, S6_READ_ONE, false, ev, 8);
+	if (err) {
+		return err;
+	}
+	if (!ev[0]) {
+		return 0;
+	}
+	unsigned left = ev[7] & 0x3fu;
+	if (left > TOUCH_MAX - 1) {
+		const uint8_t clear = S6_CLEAR_STACK;
+		(void)touch_msg(GUAC_ADDR, &clear, 1, NULL, 0, false);
+		s6_mask = 0;
+		touch_report(0, s6_x, s6_y);
+		return 0;
+	}
+	if (left) {
+		err = touch_read(GUAC_ADDR, S6_READ_ALL, false, ev + 8, left * 8u);
+		if (err) {
+			return err;
+		}
+	}
+	touch_s6_events(ev, left + 1);
+	touch_report(s6_mask, s6_x, s6_y);
+	return 0;
+}
