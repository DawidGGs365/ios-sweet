+/* OnePlus sec_power_control order: 1.8 V, 3.0 V AVDD, reset high, boot event, SENSE_ON. */
+static void
+touch_guacamole(void)
+{
+	printf("SWEET TOUCH: guacamole S6SY761: TLMM rst=%#x irq=%#x 1v8=%#x sda=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(GUAC_RST)), touch_rd(st.gpio, TOUCH_GPIO_IO(GUAC_IRQ)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(GUAC_1V8)), touch_rd(st.gpio, TOUCH_GPIO_CFG(GUAC_SDA)));
+	touch_gpio(GUAC_IRQ, 0, 0, 3, false, false);  /* input, DT bias-disable, 8 mA */
+	touch_gpio(GUAC_RST, 0, 0, 3, true, false);   /* hold reset low while rails come up */
+	touch_gpio(GUAC_1V8, 0, 3, 3, false, false);  /* tp_1v8_active: pull-up enables the switch */
+	touch_wait(5);
+	int power_error = sweet_rpmh_vreg_enable("ldoa17", 3008);
+	if (power_error) {
+		printf("SWEET TOUCH: L17A RPMh enable failed %d; stopping\n", power_error);
+		return;
+	}
+	touch_wait(10);
+	touch_gpio(GUAC_SDA, 1, 0, 0, false, false);  /* qup17, 2 mA, bias-disable */
+	touch_gpio(GUAC_SCL, 1, 0, 0, false, false);
+	touch_gpio(GUAC_RST, 0, 0, 3, true, true);
+	touch_wait(150); /* OnePlus RESET_TO_NORMAL_TIME 70 ms, Linux 140 ms */
+
+	uint8_t ev[8] = {0};
+	bool boot = false;
+	int err = 0;
+	for (unsigned i = 0; i < 50 && !st.dead; ++i) {
+		st.probing = i < 3;
+		err = touch_read(GUAC_ADDR, S6_READ_ONE, false, ev, 8);
+		unsigned type = (ev[0] >> 2) & 0x0fu;
+		if (!err && (type == 0x02 || type == 0x07) && ev[1] == 0x00) {
+			boot = true;
+			break;
+		}
+		touch_wait(20);
+	}
+	st.probing = true;
+	printf("SWEET TOUCH: s6sy761 boot event %s err=%d ev=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    boot ? "seen" : "missing", err, ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+	uint8_t bs = 0, fw = 0, id[3] = {0}, info[11] = {0};
+	int be = touch_read(GUAC_ADDR, S6_BOOT_STATUS, false, &bs, 1);
+	int ie = touch_read(GUAC_ADDR, S6_DEVICE_ID, false, id, 3);
+	int pe = touch_read(GUAC_ADDR, S6_PANEL_INFO, false, info, 11);
+	int fe = touch_read(GUAC_ADDR, S6_FW_INTEGRITY, false, &fw, 1);
+	st.probing = false;
+	printf("SWEET TOUCH: s6sy761 boot-status=%#x(err %d) id=%02x%02x%02x(err %d) panel=%ux%u tx=%u(err %d) fw-integrity=%#x(err %d)\n",
+	    bs, be, id[0], id[1], id[2], ie, (unsigned)touch_be16(info), (unsigned)touch_be16(info + 2),
+	    info[8], pe, fw, fe);
+	if (st.dead || be || bs != S6_BS_APP) {
+		printf("SWEET TOUCH: S6SY761 not in application mode; stopping\n");
+		return;
+	}
+	const uint8_t sense = S6_SENSE_ON;
+	err = touch_msg(GUAC_ADDR, &sense, 1, NULL, 0, false);
+	printf("SWEET TOUCH: selected S6SY761 @0x48 SE17, 1440x3120, sense-on err=%d, poll 10 ms + IRQ level\n", err);
+	if (err) {
+		return;
+	}
+	sweet_hid_touch_panel(1440, 3120);
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		/* IRQ gpio122 is level-low while events are queued; also read every 100 ms. */
+		if (st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(GUAC_IRQ)) & 1u) || (++ticks % 10u) == 0) {
+			err = touch_s6();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					s6_mask = 0;
+					touch_report(0, s6_x, s6_y);
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, s6_x, s6_y);
+}
